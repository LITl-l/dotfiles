#!/usr/bin/env bash
# report [--runs FILE] [--decisions FILE] — markdown tables on stdout, rendered on demand
# from the JSONL records and never stored (D6).
#
# Per (agent, task, parts): median and min–max of hidden_pass, false_done,
# blocked+timeout, wall_s, test_kill_rate and perf_speedup. Booleans count as 0/1, so a
# false_done median of 0 means most runs were honest. Nulls are left out; a metric with
# no values shows "–". parts is harness_rev.parts joined with +, or none: pooling a
# baseline with the part it is compared against hides the part's effect. no_source
# counts rows whose source_present is false, silent_stop rows whose silent_stop is true
# (pi only); a group with no row carrying the field shows "–".
# done_ok counts rows that wrote DONE with hidden_pass 1: the guard on false_done, since a
# done gate could otherwise "win" by turning false DONEs into missing ones. gate_refusals
# is a median (min–max) cell, gate_exhausted a count; both are "–" where no gate ran.
# ref_fail counts rows whose ref_pass is false: their test_kill_rate 0 means the agent's
# own ./test failed (or timed out) on the reference, not that it was weak; "–" where no
# row carries a non-null ref_pass.
# T4 rows also get their own table, per (agent, parts), of the t4_* fields in the same
# median (min–max) cells; t_Mk is t4_milestone_t.Mk over the runs that reached Mk, and
# booleans count as 0/1 as above (null verdicts left out). No T4 rows, no table.
#
# A run listed by a decision with verdict "exclude" is dropped (e.g. one that spanned a
# host suspend). Other verdicts list runs too, as evidence, and drop nothing. Decisions
# come from --decisions, else results/decisions.jsonl; missing or empty, nothing is
# dropped. The decisions table itself is printed only for an explicit --decisions.
set -uo pipefail

BENCH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
die() { printf 'report: %s\n' "$*" >&2; exit 2; }

runs="$BENCH/results/runs.jsonl" decisions="" show_decisions=false
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || die "$1 needs a file"
  case "$1" in
    --runs)      runs="$2" ;;
    --decisions) decisions="$2" show_decisions=true ;;
    *) die "unknown argument: $1" ;;
  esac
  shift 2
done
[ -r "$runs" ] || die "cannot read $runs"
if [ "$show_decisions" = true ]; then
  [ -r "$decisions" ] || die "cannot read $decisions"
else
  decisions="$BENCH/results/decisions.jsonl"
  [ -r "$decisions" ] || decisions=/dev/null
fi
excluded="$(jq -cs '[.[] | select(.verdict == "exclude") | .run_ids[]?] | unique' "$decisions")" \
  || die "cannot read exclusions from $decisions"

jq -rs --argjson excluded "$excluded" '
  ($excluded | map({(.): true}) | add // {}) as $ex
  | (map(select($ex[.run_id] | not))) as $kept
  | ([.[] | select($ex[.run_id])] | length) as $dropped
  | $kept |
  def b: if . == true then 1 elif . == false then 0 else . end;
  def median: sort | length as $n
    | if $n == 0 then null elif $n % 2 == 1 then .[($n - 1) / 2]
      else (.[$n / 2 - 1] + .[$n / 2]) / 2 end;
  def r3: if . == null then null else (. * 1000 | round) / 1000 end;
  def cell: map(select(. != null)) as $v
    | if ($v | length) == 0 then "–"
      else "\($v | median | r3) (\($v | min | r3)–\($v | max | r3))" end;
  def parts: (.harness_rev.parts // []) | if length == 0 then "none" else join("+") end;
  def silent: map(.silent_stop | select(. != null)) as $v
    | if ($v | length) == 0 then "–" else ($v | map(select(. == true)) | length | tostring) end;
  def nosrc: map(select(has("source_present")) | .source_present) as $v
    | if ($v | length) == 0 then "–" else ($v | map(select(. == false)) | length | tostring) end;
  def count_true(f): map(f | select(. != null)) as $v
    | if ($v | length) == 0 then "–" else ($v | map(select(. == true)) | length | tostring) end;
  def count_false(f): map(f | select(. != null)) as $v
    | if ($v | length) == 0 then "–" else ($v | map(select(. == false)) | length | tostring) end;
  "## Runs: median (min–max) per agent, task and parts",
  "",
  "| agent | task | parts | n | hidden_pass | false_done | done_ok | blocked+timeout | wall_s | test_kill_rate | ref_fail | perf_speedup | gate_refusals | gate_exhausted | silent_stop | no_source |",
  "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|",
  ( map(. + {_parts: parts}) | group_by([.agent, .task, ._parts])[]
    | "| \(.[0].agent) | \(.[0].task) | \(.[0]._parts) | \(length) | \(map(.hidden_pass) | cell) | \(map(.false_done | b) | cell) | \(count_true(.done_ok)) | \(map((.blocked or .timeout) | b) | cell) | \(map(.wall_s) | cell) | \(map(.test_kill_rate) | cell) | \(count_false(.ref_pass)) | \(map(.perf_speedup) | cell) | \(map(.gate_refusals) | cell) | \(count_true(.gate_exhausted)) | \(silent) | \(nosrc) |" ),
  (if length == 0 then "", "(no runs recorded)" else empty end),
  (if $dropped > 0 then "", "\($dropped) run(s) left out by an exclude decision." else empty end),
  ( map(select(.task == "T4")) | select(length > 0) |
    "",
    "## T4: median (min–max) per agent and parts",
    "",
    "| agent | parts | n | milestones_reached | t_M1 | t_M2 | t_M3 | t_M4 | t_M5 | regressions | prop_pass | perf_ok | loc | files | fmt_clean | lint_clean | compactions |",
    "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|",
    ( map(. + {_parts: parts}) | group_by([.agent, ._parts])[]
      | "| \(.[0].agent) | \(.[0]._parts) | \(length) | \(map(.t4_milestones_reached) | cell) | \(map(.t4_milestone_t.M1) | cell) | \(map(.t4_milestone_t.M2) | cell) | \(map(.t4_milestone_t.M3) | cell) | \(map(.t4_milestone_t.M4) | cell) | \(map(.t4_milestone_t.M5) | cell) | \(map(.t4_regressions) | cell) | \(map(.t4_prop_pass) | cell) | \(map(.t4_perf_ok | b) | cell) | \(map(.t4_loc) | cell) | \(map(.t4_files) | cell) | \(map(.t4_fmt_clean | b) | cell) | \(map(.t4_lint_clean | b) | cell) | \(map(.t4_compactions) | cell) |" ) )
' "$runs" || die "cannot render $runs"

if [ "$show_decisions" = true ]; then
  jq -rs '
    "",
    "## Decisions",
    "",
    "| decision_id | ts | part | verdict | runs | reason |",
    "|---|---|---|---|---|---|",
    ( .[] | "| \(.decision_id) | \(.ts) | \(.part) | \(.verdict) | \(.run_ids | length) | \(.reason | gsub("\\|"; "\\\\|") | gsub("\n"; " ")) |" ),
    (if length == 0 then "", "(no decisions recorded)" else empty end)
  ' "$decisions" || die "cannot render $decisions"
fi
