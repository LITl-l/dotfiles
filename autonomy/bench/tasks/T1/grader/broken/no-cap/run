#!/usr/bin/env python3
"""Broken T1: the 25 percent cap is never applied."""
import importlib.util
import os
import sys
from importlib.machinery import SourceFileLoader

sys.dont_write_bytecode = True  # loading solution/run must not leave __pycache__ in it
path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../../solution/run")
loader = SourceFileLoader("t1_reference", path)
ref = importlib.util.module_from_spec(importlib.util.spec_from_loader("t1_reference", loader))
loader.exec_module(ref)

ref.cap = lambda pct: pct
ref.main()
