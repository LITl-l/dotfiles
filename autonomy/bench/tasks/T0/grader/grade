#!/usr/bin/env bash
# T0 hidden grader. Usage: grade <solution_dir>. Contract: ../../../lib/grader.sh.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
. "$here/../../../lib/grader.sh"

sol="${1:?usage: grade <solution_dir>}"
errf="$(mktemp)"
trap 'rm -f "$errf"' EXIT

total="$(jq length "$here/cases.json")" || exit 2
if [ -e "$sol/run" ]; then
  passed="$(cd "$sol" && run_io_cases "$sol/run" "$here/cases.json" "$errf")"
else
  passed=0
  echo "no ./run" >> "$errf"
fi
ktr="$(kill_rate "$sol" "$here/../solution/run" "$here"/broken/*/)"
emit "$passed" "$total" "$ktr" null 0 "$errf"
