#!/usr/bin/env bash
# build-cases [goldens.json] — print the hidden acceptance suite, a Rust integration test
# (tests/plover_format_hidden.rs), built from grader/goldens.json.
#
# One #[test] fn case_NNN per golden, NNN its 1-based position, so a panic costs exactly
# one case and the grader can count `test case_NNN ... ok`. Every "format" case checks
# format(), text() and the replay of each apply's Output; every "ops" case checks each
# Output exactly, then text() and the replay. The suite calls only the public API SPEC.md
# fixes, so API drift fails to compile and fails every case.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
goldens="${1:-$here/goldens.json}"

cat <<'EOF'
// Generated by the bench grader from its goldens. Do not edit.
use steno_core::{format, Formatter, Output};

enum Op {
    Apply(&'static str),
    Undo,
}

fn replay(buf: &mut String, o: &Output) {
    for _ in 0..o.backspaces {
        assert!(buf.pop().is_some(), "more backspaces than text: {o:?}");
    }
    buf.push_str(&o.text);
}

fn check_format(input: &[&str], want: &str) {
    assert_eq!(format(input), want, "format({input:?})");
    let mut f = Formatter::new();
    let mut buf = String::new();
    for t in input {
        let o = f.apply(t);
        replay(&mut buf, &o);
    }
    assert_eq!(f.text(), want, "text() after applying {input:?}");
    assert_eq!(buf, want, "replayed Outputs of {input:?}");
}

fn check_ops(ops: &[Op], want: &[(usize, &str)], text: &str) {
    let mut f = Formatter::default();
    let mut buf = String::new();
    for (i, op) in ops.iter().enumerate() {
        let o = match op {
            Op::Apply(t) => f.apply(t),
            Op::Undo => f.undo(),
        };
        let expected = Output {
            backspaces: want[i].0,
            text: want[i].1.to_string(),
        };
        assert_eq!(o, expected, "Output of op {i}");
        replay(&mut buf, &o);
    }
    assert_eq!(f.text(), text, "text() at the end");
    assert_eq!(buf, text, "replayed Outputs");
}
EOF

# jq's tojson is a valid Rust string literal as long as no control character needs a
# \u escape (Rust spells those \u{..}); refuse such goldens rather than miscompile them.
# shellcheck disable=SC2016 # a jq program
jq -r '
  def lit: if test("[\u0000-\u001f\u007f]") then error("control character in \(tojson)") else tojson end;
  to_entries[] | .key as $i | .value as $c
  | "\n#[test]\nfn case_\(($i + 1) | tostring | ("000" + .)[-3:])() {\n    // \($c.name) (\($c.category), \($c.oracle))\n"
    + (if $c.kind == "format" then
         "    check_format(&[\($c.input | map(lit) | join(", "))], \($c.text | lit));\n"
       elif $c.kind == "ops" then
         "    check_ops(\n        &[\($c.ops | map(if .undo then "Op::Undo" else "Op::Apply(\(.apply | lit))" end) | join(", "))],\n"
         + "        &[\($c.outputs | map("(\(.[0]), \(.[1] | lit))") | join(", "))],\n"
         + "        \($c.text | lit),\n    );\n"
       else error("unknown kind \($c.kind)") end)
    + "}"' "$goldens"
