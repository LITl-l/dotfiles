#!/usr/bin/env bash
# run — one bench run: workspace -> agent -> wait -> grade -> append one runs.jsonl row.
#
#   run --agent claude|pi|fixture:<dir> --task T0..T5 --rep N --parts <list|none>
#       [--model ID] [--timeout S] [--results FILE]
#
# fixture:<dir> installs <dir> (relative to this bench, or absolute) over the workspace
# instead of dispatching an agent, so the whole path is testable without spending tokens.
# --parts P0 sandboxes the session's Bash and presets BENCH_TARGET (parts/P0.settings.json),
# and tells the agent so (parts/P0.prompt.md). --parts P0d adds a PreToolUse hook that
# approves every Bash call; it needs P0 in the same list, since only P0's sandbox makes
# approving arbitrary Bash safe. --parts R1 adds llama-server flags for a pi run
# (parts/R1.llm.json) and is refused for claude. A part with none of these files is
# recorded but changes nothing.
# --parts P1 (claude) and R3 (pi) add the done gate (lib/done-gate.sh): a Stop hook
# (parts/P1.stop-hook.sh) or a pi extension (parts/R3.pi-ext.ts) that deletes DONE unless
# the agent's ./test passes on ./run and fails on gate-built broken copies. Each is
# refused for the other agent. Their verdicts land in <ws>.gate.jsonl.
# A task whose grader ships an executable `milestones` (T4) gets a periodic check while an
# agent works: run starts it beside the session and stops it when the session ends. Its
# points land in <ws>.milestones.jsonl. The grader's "extra" then becomes the row's t4_*
# fields (t4_row below); other tasks' rows never carry them.
# A "repo" task (T5) ships tasks/<T>/repo.json instead of a skeleton: its workspace is a
# clone of an existing repository (lib/repo.sh), named bench-<run_id> under a directory
# named after the repository. Any task may ship tasks/<T>/prompt.md, used in place of
# prompt.md, and tasks/<T>/settings.json, merged after the parts with its arrays appended
# rather than replaced; there @DEVPATH@ is the bench devShell's PATH (cargo and friends).
# The T5 grader's "extra" becomes the row's boundary_ok and t5_* fields (t5_row below).
# Exit codes: 0 row appended, 2 usage error, 1 the run could not complete.
#
# Env: BENCH_WS_ROOT overrides the run workspace root (default ~/wkspace/worktree/bench,
#        or ~/wkspace/worktree/<repo name> for a repo task).
#      BENCH_SNAPSHOT_INTERVAL overrides the milestone check's period (default 1200 s).
#      BENCH_DEVPATH and BENCH_CARGO_REGISTRY: see lib/repo.sh.
set -uo pipefail

BENCH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$BENCH/../.." && pwd)"
# The flake's shellcheck lints one file at a time, so sourced libs are not followed.
# shellcheck source=/dev/null
. "$BENCH/lib/fs.sh"
# shellcheck source=/dev/null
. "$BENCH/lib/lang.sh"
# shellcheck source=/dev/null
. "$BENCH/lib/clock.sh"
# shellcheck source=/dev/null
. "$BENCH/lib/proc.sh"
# shellcheck source=/dev/null
. "$BENCH/lib/repo.sh"

KILL_GRACE=5  # seconds between the watchdog's TERM and its KILL

usage() { printf 'run: %s\n' "$*" >&2; exit 2; }
fail()  { printf 'run: %s\n' "$*" >&2; exit 1; }

agent="" task="" rep="" parts="" model="" tmo="" results="$BENCH/results/runs.jsonl"
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || usage "$1 needs a value"
  case "$1" in
    --agent)   agent="$2" ;;
    --task)    task="$2" ;;
    --rep)     rep="$2" ;;
    --parts)   parts="$2" ;;
    --model)   model="$2" ;;
    --timeout) tmo="$2" ;;
    --results) results="$2" ;;
    *) usage "unknown flag: $1" ;;
  esac
  shift 2
done

case "$agent" in
  claude|pi) kind="$agent" ;;
  fixture:?*) kind=fixture ;;
  *) usage "--agent must be claude, pi or fixture:<dir> (got '$agent')" ;;
esac
[[ "$task" =~ ^T[0-5]$ ]] || usage "--task must be T0..T5 (got '$task')"
repo_task=false
[ -f "$BENCH/tasks/$task/repo.json" ] && repo_task=true
[ "$repo_task" = true ] || [ -d "$BENCH/tasks/$task/skeleton" ] \
  || usage "task $task has no skeleton/ or repo.json yet"
[[ "$rep" =~ ^[1-9][0-9]*$ ]] || usage "--rep must be a positive integer (got '$rep')"
[ -n "$parts" ] || usage "--parts is required (a comma list, or none)"
[[ "$parts" =~ ^(none|[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*)$ ]] || usage "bad --parts '$parts'"
# Hook decisions cannot lift deny or ask rules, but outside the sandbox P0d's hook would
# approve anything else that reaches Bash.
[[ ",$parts," == *,P0d,* && ",$parts," != *,P0,* ]] \
  && usage "part P0d needs P0 in the same --parts list (its hook approves Bash only because P0 sandboxes it)"
[ -z "$tmo" ] || [[ "$tmo" =~ ^[1-9][0-9]*$ ]] || usage "--timeout must be whole seconds"
case "$kind" in
  # spec §1 0c initial value; revised only from 0c data. T4 is staged over five
  # milestones and gets four times as long (phase2a design); T5 builds Rust cold in an
  # existing repo and gets twice as long (phase2b design).
  claude) case "$task" in T4) tmo="${tmo:-14400}" ;; T5) tmo="${tmo:-7200}" ;; *) tmo="${tmo:-3600}" ;; esac ;;
  pi) [ -n "$model" ] || usage "--agent pi needs --model"
      [ -n "$tmo" ] || usage "--agent pi needs --timeout (set from Phase 0b)" ;;
  fixture)
    fx="${agent#fixture:}"
    [ "${fx:0:1}" = / ] || fx="$BENCH/$fx"
    [ -d "$fx" ] || usage "fixture dir not found: $fx" ;;
esac

part_list=()
[ "$parts" = none ] || IFS=, read -ra part_list <<< "$parts"
#    A part that changes the pi model server ships parts/<part>.llm.json,
#    {"server_flags_extra": [...]}, appended to llama-server's flags for a pi run (via
#    llm's BENCH_LLM_SERVER_FLAGS_EXTRA). Claude talks to no local server, so a claude
#    run naming a part that changes nothing else is refused: its rows would carry a
#    part label for a run the part never touched. Fixture runs dispatch nothing anyway.
llm_extra='[]'
for p in "${part_list[@]}"; do
  f="$BENCH/parts/$p.llm.json"
  [ -f "$f" ] || continue
  if [ "$kind" = claude ] && [ ! -f "$BENCH/parts/$p.settings.json" ] && [ ! -f "$BENCH/parts/$p.prompt.md" ]; then
    usage "part $p only changes the pi model server (parts/$p.llm.json); it has no effect on claude"
  fi
  llm_extra="$(jq -ce --argjson acc "$llm_extra" '
    .server_flags_extra | select(type == "array" and all(.[]; type == "string")) | $acc + .' "$f")" \
    || usage "parts/$p.llm.json: server_flags_extra must be an array of strings"
done
#    The done gate has one mechanism per agent: a claude Stop hook, a pi extension. A run
#    naming the other agent's gate would carry a gate label for a run nothing gated.
#    Fixture runs dispatch nothing, so either is accepted there.
gate_parts=() pi_exts=""
for p in "${part_list[@]}"; do
  if [ -f "$BENCH/parts/$p.pi-ext.ts" ]; then
    [ "$kind" = claude ] && usage "part $p is a pi extension (parts/$p.pi-ext.ts); it has no effect on claude"
    gate_parts+=("$p") pi_exts+="${pi_exts:+:}$BENCH/parts/$p.pi-ext.ts"
  fi
  if [ -f "$BENCH/parts/$p.stop-hook.sh" ]; then
    [ "$kind" = pi ] && usage "part $p is a claude Stop hook (parts/$p.stop-hook.sh); it has no effect on pi"
    gate_parts+=("$p")
  fi
done

run_id="$task-$kind-r$rep-$(date -u +%Y%m%dT%H%M%SZ)-$$$RANDOM"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
if [ "$repo_task" = true ]; then
  repo_name="$(jq -r '.src // "" | sub("/+$"; "") | split("/") | last | sub("\\.git$"; "")' \
    "$BENCH/tasks/$task/repo.json")" || usage "tasks/$task/repo.json is not valid JSON"
  [ -n "$repo_name" ] || usage "tasks/$task/repo.json has no src"
  ws="${BENCH_WS_ROOT:-$HOME/wkspace/worktree/$repo_name}/bench-$run_id"
else
  ws="${BENCH_WS_ROOT:-$HOME/wkspace/worktree/bench}/$run_id"
fi
[ -e "$ws" ] && fail "workspace already exists: $ws"

# 1. Workspace from the task skeleton, or a clone of the task's repository.
if [ "$repo_task" = true ]; then
  repo_install "$BENCH/tasks/$task" "$ws" || fail "cannot clone the task repository into $ws"
else
  install_tree "$BENCH/tasks/$task/skeleton" "$ws" || fail "cannot populate $ws"
fi

# 2. Bench-only project settings. Every deny entry holding @ROOT@ is expanded once per
#    root: this checkout, the canonical checkout, and the worktree root that holds every
#    other workspace (including other bench runs, whose skeletons are harmless but whose
#    neighbours are not).
roots="$(printf '%s\n' "$REPO" "$HOME/.config/dotfiles" "$HOME/wkspace/worktree" | jq -R . | jq -sc 'unique')"
mkdir -p "$ws/.claude"
jq --argjson roots "$roots" '
  .permissions.deny |= ([ .[] as $r
    | if ($r | contains("@ROOT@")) then ($roots[] as $root | $r | gsub("@ROOT@"; $root))
      else $r end ] | unique)' \
  "$BENCH/settings.template.json" > "$ws/.claude/settings.json" || fail "cannot write bench settings"

#    A part that changes the session's settings ships parts/<part>.settings.json, merged
#    over the render above. Its @ROOT@ entries expand once per root like the deny rules;
#    @WS@ is this workspace, @BENCH@ this bench directory. The template render itself is left alone so that --parts none
#    stays byte-identical to the settings the baseline rows ran under.
if [ "$parts" != none ]; then
  for p in "${part_list[@]}"; do
    overlay="$BENCH/parts/$p.settings.json"
    [ -f "$overlay" ] || continue
    merged="$(jq -s --argjson roots "$roots" --arg ws "$ws" --arg bench "$BENCH" '
      (.[1] | walk(
        if type == "array" then [ .[] as $e
          | if ($e | type) == "string" and ($e | contains("@ROOT@"))
            then ($roots[] as $root | $e | gsub("@ROOT@"; $root)) else $e end ]
        elif type == "string" then gsub("@WS@"; $ws) | gsub("@BENCH@"; $bench)
        else . end)) as $o
      | .[0] * $o' "$ws/.claude/settings.json" "$overlay")" || fail "cannot merge $overlay"
    printf '%s\n' "$merged" > "$ws/.claude/settings.json" || fail "cannot write bench settings"
  done
fi

#    A task that needs settings of its own ships tasks/<task>/settings.json, merged last.
#    Unlike a part's overlay, its arrays are appended to (a task adds an allowWrite entry
#    beside P0's, it does not replace it). Placeholders as above, plus @DEVPATH@.
task_overlay="$BENCH/tasks/$task/settings.json"
if [ -f "$task_overlay" ]; then
  devpath=""
  if grep -q '@DEVPATH@' "$task_overlay"; then
    devpath="$(repo_devpath "$REPO")"
    [ -n "$devpath" ] || fail "cannot resolve @DEVPATH@ (nix develop $REPO#bench --offline)"
  fi
  merged="$(jq -s --argjson roots "$roots" --arg ws "$ws" --arg bench "$BENCH" --arg devpath "$devpath" '
    def merge($a; $b):
      if ($a | type) == "object" and ($b | type) == "object" then
        reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k]))
      elif ($a | type) == "array" and ($b | type) == "array" then $a + ($b - $a)
      else $b end;
    (.[1] | walk(
      if type == "array" then [ .[] as $e
        | if ($e | type) == "string" and ($e | contains("@ROOT@"))
          then ($roots[] as $root | $e | gsub("@ROOT@"; $root)) else $e end ]
      elif type == "string" then gsub("@WS@"; $ws) | gsub("@BENCH@"; $bench) | gsub("@DEVPATH@"; $devpath)
      else . end)) as $o
    | merge(.[0]; $o)' "$ws/.claude/settings.json" "$task_overlay")" || fail "cannot merge $task_overlay"
  printf '%s\n' "$merged" > "$ws/.claude/settings.json" || fail "cannot write bench settings"
fi

#    The prompt handed to the agent. A part that must tell the agent something ships
#    parts/<part>.prompt.md, inserted as the last lines of the ## Boundary section. It is
#    written beside the workspace, not in it, so the agent's tree and the grader never see
#    it; --parts none renders prompt.md byte for byte.
prompt="$ws.prompt.md"
base_prompt="$BENCH/prompt.md"
[ -f "$BENCH/tasks/$task/prompt.md" ] && base_prompt="$BENCH/tasks/$task/prompt.md"
additions=""
if [ "$parts" != none ]; then
  for p in "${part_list[@]}"; do
    [ -f "$BENCH/parts/$p.prompt.md" ] && additions+="$(cat "$BENCH/parts/$p.prompt.md")"$'\n'
  done
fi
if [ -z "$additions" ]; then
  cat "$base_prompt" > "$prompt" || fail "cannot write $prompt"
else
  awk -v add="$additions" '
    /^## / { if (inb) { printf "%s", add; inb = 0; done = 1 } if (/^## *Boundary/) inb = 1 }
    inb && /^$/ { blank++; next }
    { while (blank > 0) { print ""; blank-- } print }
    END { if (!done) exit 1 }' "$base_prompt" > "$prompt" || fail "cannot render $prompt"
fi

# 3-5. Dispatch, wait, reap.
blocked=false timed_out=false tokens=null tool_cpu=null
# wall_s is CLOCK_MONOTONIC (lib/clock.sh says why). Without python3 or perl, as in the
# flake check's sandbox, it falls back to the realtime clock and says so; a real pi run
# never gets there, because its adapter needs python3 too.
clock=monotonic
if ! start="$(mono_now)"; then
  clock=realtime start="$EPOCHREALTIME"
  echo "run: no CLOCK_MONOTONIC reader (python3 or perl); wall_s uses the realtime clock" >&2
fi
clock_now() { if [ "$clock" = monotonic ]; then mono_now; else echo "$EPOCHREALTIME"; fi; }

claude_session() { # prints the newest inventory row named $1, or nothing
  claude agents --json --all 2>/dev/null \
    | jq -c --arg n "$1" '[.[] | select(.name == $n)] | last // empty' 2>/dev/null
}

# The periodic milestone check (T4). Fixture runs have no time to sample, so none starts.
snap_pid=""
snapper="$BENCH/tasks/$task/grader/milestones"
if [ "$kind" != fixture ] && [ -f "$snapper" ]; then
  setsid bash "$snapper" "$ws" "$ws.milestones.jsonl" "${BENCH_SNAPSHOT_INTERVAL:-1200}" \
    > /dev/null 2>&1 < /dev/null &
  snap_pid=$!
fi

compactions=null
case "$kind" in
  fixture)
    install_tree "$fx" "$ws" || fail "cannot install fixture $fx"
    ;;
  claude)
    name="bench-$run_id"
    spawn=(fleet spawn --name "$name" --dir "$ws" --spec "$prompt")
    [ -n "$model" ] && spawn+=(--model "$model")
    "${spawn[@]}" >&2 || fail "fleet spawn failed"
    # Ends on the first of: done, blocked >= 60 s continuously, timeout. Nothing is ever
    # sent to the session (D9), so a blocked state can only be a tool prompt.
    t0=$SECONDS blocked_since="" missing_since="" sid="" sess=""
    while :; do
      row="$(claude_session "$name")"
      if [ -z "$row" ]; then
        missing_since="${missing_since:-$SECONDS}"
        (( SECONDS - missing_since >= 60 )) && { echo "run: session $name vanished" >&2; break; }
      else
        missing_since=""
        sid="$(jq -r '.id // .sessionId[0:8] // ""' <<< "$row")"
        sess="$(jq -r '.sessionId // ""' <<< "$row")"
        st="$(jq -r '.state // .status // ""' <<< "$row")"
        wf="$(jq -r '.waitingFor // ""' <<< "$row")"
        case "$st" in done|completed|finished|stopped|idle) break ;; esac
        if [ "$st" = blocked ] || [ "$st" = waiting ] || [ -n "$wf" ]; then
          blocked_since="${blocked_since:-$SECONDS}"
          (( SECONDS - blocked_since >= 60 )) && { blocked=true; break; }
        else
          blocked_since=""
        fi
      fi
      (( SECONDS - t0 >= tmo )) && { timed_out=true; break; }
      sleep 10
    done
    # Context compactions, from the session transcript's compact_boundary entries; read
    # before the reap, and null when no transcript is found.
    if [ -n "$sess" ]; then
      tr_file="$(find "$HOME/.claude/projects" -name "$sess.jsonl" -print -quit 2> /dev/null)"
      [ -n "$tr_file" ] && compactions="$(grep -c '"subtype":"compact_boundary"' "$tr_file")"
    fi
    if [ -n "$sid" ]; then
      claude stop "$sid" >&2 2>/dev/null || true
      claude rm "$sid" >&2 2>/dev/null || echo "run: claude rm $sid failed; try fleet gc" >&2
    fi
    # tokens stays null: reading usage out of the transcript is not implemented yet.
    ;;
  pi)
    # BENCH_LLM lets the selftest swap in a stub adapter, so this branch runs without a model.
    llm="${BENCH_LLM:-$BENCH/llm}"; [ -d "$llm" ] && llm="$llm/llm"
    [ -f "$llm" ] || fail "pi runs need the WP6 llm adapter ($llm)"
    # The limit is enforced here, not trusted to the adapter: its inner timeout under
    # bwrap let one run overrun (G5) and a host suspend defeat another (wall_s 50586).
    # setsid gives the adapter a session of its own, so the watchdog can find the whole
    # tree (lib/proc.sh). Its output goes to a file, not a pipe: a surviving child
    # holding the pipe open would keep run waiting.
    # pi gets the rendered prompt, so a part's prompt line reaches it as it reaches claude
    # (without a part line it is prompt.md byte for byte), and the parts' extensions.
    pi_out="$ws.pi-run.json" marker="$ws.pi-run.timeout"
    BENCH_PI_PROMPT="$prompt" BENCH_PI_EXTENSIONS="$pi_exts" \
      BENCH_LLM_SERVER_FLAGS_EXTRA="$llm_extra" \
      setsid bash "$llm" pi-run "$ws" "$model" "$tmo" > "$pi_out" &
    pi_pid=$!
    watchdog "$pi_pid" "$tmo" "$KILL_GRACE" "$marker" &
    wd_pid=$!
    wait "$pi_pid"
    pi_rc=$?
    kill "$wd_pid" 2> /dev/null
    wait "$wd_pid" 2> /dev/null
    reap_tree "$pi_pid" "$KILL_GRACE"   # whatever the adapter left behind
    if [ -e "$marker" ]; then
      timed_out=true
      echo "run: pi-run reached the ${tmo}s limit; its process tree was stopped" >&2
    else
      [ "$pi_rc" -eq 0 ] || fail "llm pi-run failed (exit $pi_rc)"
      timed_out="$(jq -r '.timeout == true' "$pi_out")" || fail "bad pi-run output: $(cat "$pi_out")"
    fi
    # A run stopped by the watchdog may have printed nothing; its figures are then null.
    if jq -e 'type == "object"' "$pi_out" > /dev/null 2>&1; then
      tool_cpu="$(jq -c '.tool_cpu_s // null' "$pi_out")"
      tokens="$(jq -c '.tokens // null' "$pi_out")"
    fi
    ;;
esac
end="$(clock_now)" || fail "cannot read the clock"
# Stop the milestone check before grading: its own grade must not compete for the CPU
# with the final one, and nothing may keep running after the row is written.
if [ -n "$snap_pid" ]; then
  reap_tree "$snap_pid" "$KILL_GRACE"
  wait "$snap_pid" 2> /dev/null
fi
# An adapter's own timeout verdict under-reports: under bwrap --unshare-pid a pi run
# overran 3540 s by 10.9 s and still said timeout:false (G5). Reaching the limit is a
# timeout whatever the agent reports. Only fixture runs, which have no limit, skip this.
if [ -n "$tmo" ] && [ "$timed_out" != true ]; then
  timed_out="$(jq -n --argjson s "$start" --argjson e "$end" --argjson l "$tmo" '($e - $s) >= $l')" \
    || fail "cannot compare wall time with the limit"
fi

# 6. Grade and append.
g="$(bash "$BENCH/grade" "$task" "$ws")" || fail "grading failed for $ws"

plugin_rev=null
plugin_dir="claude/marketplaces/local/plugins/autonomy"
if [ -d "$REPO/$plugin_dir" ] && command -v jj > /dev/null; then
  rev="$(cd "$REPO" && jj log --ignore-working-copy --no-graph \
    -r "latest(::@ & files(\"$plugin_dir\"))" -T commit_id 2>/dev/null)"
  [ -n "$rev" ] && plugin_rev="$(jq -Rn --arg r "$rev" '$r')"
fi
[ "$parts" = none ] && parts_json='[]' || parts_json="$(jq -Rc 'split(",")' <<< "$parts")"
done_file=false; [ -f "$ws/DONE" ] && done_file=true

# silent_stop (pi only): pi exited on its own without finishing. Its final assistant
# message hit the output cap (stopReason "length": a T2 turn spent all 16384 tokens
# thinking and pi just quit), or it made no tool call and no DONE file exists. A run the
# limit stopped is a timeout, not a silent stop. null when pi left no events
# (llm pi-run keeps them in <ws>.pi/events.jsonl).
# shellcheck disable=SC2016 # a jq program: $ev, $m, $done_file and $timeout are jq variables
SILENT_STOP_JQ='
  [inputs | fromjson? | objects] as $ev
  | if ($ev | any(.type == "agent_start")) | not then null
    elif $timeout then false
    else ([$ev[] | select(.type == "message_end" and .message.role? == "assistant")
            | .message] | last) as $m
      | ($m.stopReason? == "length")
        or (([$m.content[]? | select(.type? == "toolCall")] | length) == 0 and ($done_file | not))
    end'
silent_stop=absent
if [ "$kind" = pi ]; then
  silent_stop="$(jq -Rn --argjson done_file "$done_file" --argjson timeout "$timed_out" \
    "$SILENT_STOP_JQ" "$ws.pi/events.jsonl" 2> /dev/null)" || silent_stop=null
fi

# The done gate's verdicts (parts/P1.stop-hook.sh, parts/R3.pi-ext.ts), one JSON line each
# in <ws>.gate.jsonl. null when no gate ran: no gate part, or a fixture run.
gate_refusals=null gate_exhausted=null
if [ -s "$ws.gate.jsonl" ]; then
  gate_refusals="$(jq -s '[.[] | select(.verdict == "refused")] | length' "$ws.gate.jsonl")" \
    || fail "bad gate ledger $ws.gate.jsonl"
  gate_exhausted="$(jq -s 'any(.[]; .verdict == "exhausted")' "$ws.gate.jsonl")" \
    || fail "bad gate ledger $ws.gate.jsonl"
elif [ "${#gate_parts[@]}" -gt 0 ] && [ "$kind" != fixture ]; then
  gate_refusals=0 gate_exhausted=false
fi

# T4: the grader's extra and the milestone series become t4_* fields. The series is every
# periodic point plus the final grade at t = wall_s. Mk is reached when the final grade
# has it at 1.0; t4_milestone_t[Mk] is then the first point at 1.0 (the final one when no
# periodic point got there, as in a fixture run), else null. A regression is a point
# below 1.0 right after a point at 1.0, counted per milestone.
t4_row=null
if [ "$task" = T4 ]; then
  t4_points='[]'
  if [ -s "$ws.milestones.jsonl" ]; then
    t4_points="$(jq -cs '[.[] | select(type == "object" and (.t | type) == "number")]' "$ws.milestones.jsonl")" \
      || fail "bad milestone series $ws.milestones.jsonl"
  fi
  # shellcheck disable=SC2016 # a jq program; $g, $pts, $wall and $comp are jq variables
  t4_row="$(jq -cn --argjson g "$g" --argjson pts "$t4_points" --argjson comp "$compactions" \
    --argjson wall "$(jq -n --argjson s "$start" --argjson e "$end" '(($e - $s) * 1000 | round) / 1000')" '
    ($g.extra // error("the T4 grader printed no extra")) as $x
    | ($pts + [{t: $wall} + $x.milestones]) as $series
    | ["M1", "M2", "M3", "M4", "M5"] as $ms
    | ($ms | map(. as $m | {key: $m, value:
        (if $x.milestones[$m] == 1 then [$series[] | select(.[$m] == 1) | .t][0] else null end)})
        | from_entries) as $mt
    | {t4_milestones_reached: ($mt | map(select(. != null)) | length),
       t4_milestone_t: $mt,
       t4_regressions: ([$ms[] as $m | range(1; $series | length) as $i
         | select($series[$i - 1][$m] == 1 and $series[$i][$m] < 1)] | length),
       t4_prop_pass: $x.prop_pass, t4_perf_ok: $x.perf_ok,
       t4_loc: $x.loc, t4_files: $x.files,
       t4_fmt_clean: $x.fmt_clean, t4_lint_clean: $x.lint_clean,
       t4_compactions: $comp}')" || fail "cannot build the T4 fields"
fi

# T5: the grader's extra becomes boundary_ok and the t5_* fields, as T4's does without the
# milestone series (T5 has no periodic check).
t5_row=null
if [ "$task" = T5 ]; then
  # shellcheck disable=SC2016 # a jq program; $g and $comp are jq variables
  t5_row="$(jq -cn --argjson g "$g" --argjson comp "$compactions" '
    ($g.extra // error("the T5 grader printed no extra")) as $x
    | {boundary_ok: $x.boundary_ok, t5_regress_ok: $x.regress_ok,
       t5_hidden_compiled: $x.hidden_compiled, t5_loc: $x.loc,
       t5_fmt_clean: $x.fmt_clean, t5_lint_clean: $x.lint_clean,
       t5_compactions: $comp}')" || fail "cannot build the T5 fields"
fi

row="$(jq -cn \
  --arg run_id "$run_id" --arg ts "$ts" --arg agent "$agent" --arg model "$model" \
  --argjson parts "$parts_json" --argjson plugin_rev "$plugin_rev" \
  --arg task "$task" --argjson rep "$rep" --argjson g "$g" \
  --argjson done_file "$done_file" --argjson blocked "$blocked" --argjson timeout "$timed_out" \
  --argjson start "$start" --argjson end "$end" \
  --argjson tokens "$tokens" --argjson tool_cpu "$tool_cpu" --arg lang "$(detect_lang "$ws")" \
  --argjson source_present "$(source_present "$ws")" --arg silent_stop "$silent_stop" \
  --argjson gate_refusals "$gate_refusals" --argjson gate_exhausted "$gate_exhausted" \
  --argjson t4 "$t4_row" --argjson t5 "$t5_row" '
  {run_id: $run_id, ts: $ts, agent: $agent,
   model: (if $model == "" then null else $model end),
   harness_rev: {parts: $parts, plugin_rev: $plugin_rev},
   task: $task, rep: $rep,
   hidden_pass: $g.hidden_pass, test_kill_rate: $g.test_kill_rate, ref_pass: $g.ref_pass,
   perf_speedup: $g.perf_speedup,
   false_done: ($done_file and $g.hidden_pass < 1),
   done_ok: ($done_file and $g.hidden_pass == 1),
   blocked: $blocked, timeout: $timeout,
   wall_s: ((($end - $start) * 1000 | round) / 1000),
   tokens: $tokens, tool_cpu_s: $tool_cpu,
   lang: (if $lang == "unknown" then null else $lang end),
   source_present: $source_present,
   gate_refusals: $gate_refusals, gate_exhausted: $gate_exhausted}
  + (if $silent_stop == "absent" then {} else {silent_stop: ($silent_stop | fromjson)} end)
  + ($t4 // {}) + ($t5 // {})')" \
  || fail "cannot build row"

printf '%s\n' "$row" | bash "$BENCH/record" --results "$results" || fail "record rejected the row"
printf '%s\n' "$row"
