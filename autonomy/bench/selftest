check "T4: rendered Read denies cover tasks/T4/grader under every root" \
  exits 0 jq -e --argjson roots "$t4_roots" "$G2R"'
  [.permissions.deny[] | select(startswith("Read(")) | ltrimstr("Read(") | rtrimstr(")") | sub("^//"; "/")] as $g
  | all($roots[] + "/autonomy/bench/tasks/T4/grader/cases/M1.cases"; . as $p | any($g[]; . as $x | $p | test($x | g2r)))' \
  "$t4_ws/.claude/settings.json"
check "T4: P0 sandbox denyRead covers tasks/T4/grader under every root" \
  exits 0 jq -e --argjson roots "$t4_roots" "$G2R"'
  .sandbox.filesystem.denyRead as $g
  | all($roots[] + "/autonomy/bench/tasks/T4/grader/cases/M1.cases"; . as $p | any($g[]; . as $x | $p | test($x | g2r)))' \
  "$p0_s"
check "T4: the glob check itself rejects a path outside any grader tree" \
  exits 1 jq -e --argjson roots "$t4_roots" "$G2R"'
  .sandbox.filesystem.denyRead as $g
  | all($roots[] + "/autonomy/bench/tasks/T4/skeleton/SPEC.md"; . as $p | any($g[]; . as $x | $p | test($x | g2r)))' \
  "$p0_s"

# The reference solutions are answers (T4's is a complete ledger.c): denied like the grader.
# covers_solution <settings> — every Read and Edit deny set covers T1's and T4's solution
# under every root, and the P0 sandbox denyRead (when present) does too.
SOL_JQ="$G2R"'
  def covered($g): all($roots[] + ("/autonomy/bench/tasks/T4/solution/ledger.c", "/autonomy/bench/tasks/T1/solution/run");
    . as $p | any($g[]; . as $x | $p | test($x | g2r)));
  def rules($t): [.permissions.deny[] | select(startswith($t + "(")) | ltrimstr($t + "(") | rtrimstr(")") | sub("^//"; "/")];
  covered(rules("Read")) and covered(rules("Edit"))
  and (if .sandbox then covered(.sandbox.filesystem.denyRead) else true end)'
covers_solution() { jq -e --argjson roots "$t4_roots" "$SOL_JQ" "$1" > /dev/null; }
check "T4: rendered settings deny Read and Edit of tasks/T4/solution and tasks/T1/solution" \
  covers_solution "$t4_ws/.claude/settings.json"
check "P0: rendered settings and sandbox denyRead cover the solution trees too" covers_solution "$p0_s"
jq '.permissions.deny |= map(select(test("/solution/") | not))' "$t4_ws/.claude/settings.json" > "$tmp/nosol.json"
check "T4: the solution check rejects settings without the solution denies" \
  exits 1 covers_solution "$tmp/nosol.json"
jq '.sandbox.filesystem.denyRead |= map(select(test("/solution/") | not))' "$p0_s" > "$tmp/nosol-p0.json"
check "P0: the solution check rejects a sandbox denyRead without the solution trees" \
  exits 1 covers_solution "$tmp/nosol-p0.json"

# The periodic milestone check writes nothing into the workspace it samples.
snapws="$tmp/snapws"
mkdir -p "$snapws"
cp -R "$BENCH/tasks/T4/skeleton/." "$snapws/"
tree_sum() { (cd "$1" && find . -print0 | LC_ALL=C sort -z | xargs -0 ls -ld --time-style=+%s.%N | sha256sum) ; }
snap_before="$(tree_sum "$snapws")"
bash "$T4B/tasks/T4/grader/milestones" "$snapws" "$tmp/snap.jsonl" 1 > /dev/null 2>&1 &
snap_pid=$!
for _ in $(seq 1 240); do [ -s "$tmp/snap.jsonl" ] && break; sleep 0.5; done
kill -TERM "$snap_pid" 2> /dev/null; wait "$snap_pid" 2> /dev/null
check "milestones: wrote a point {t, M1..M5, prop}, all 0 for the stub" \
  test "$(head -n 1 "$tmp/snap.jsonl" | jq -c '(keys_unsorted == ["t","M1","M2","M3","M4","M5","prop"]) and ([.M1,.M2,.M3,.M4,.M5,.prop] | all(. == 0))')" = true
check "milestones: the sampled workspace is unchanged, byte for byte and in mtimes" \
  test "$(tree_sum "$snapws")" = "$snap_before"
check "milestones: TERM removes its snapshot directory" test ! -e "$snapws.snap"

# A stubbed pi run: it installs the reference, waits for a periodic point at M1 = 1, then
# regresses to broken/elided-sign. The row must reach only the milestones the final grade
# holds, date M1 from the periodic point, and count the regressions.
cat > "$tmp/llm-stub-t4" <<'EOF'
[ "$1" = pi-run ] || exit 1
. "$STUB_T4_LIB"
install_ref "$2" > /dev/null 2>&1 || exit 1
for _ in $(seq 1 600); do
  [ -s "$2.milestones.jsonl" ] && jq -se 'any(.[]; .M1 == 1)' "$2.milestones.jsonl" > /dev/null 2>&1 && break
  sleep 0.5
done
rm -rf "$2/.build"
install_broken elided-sign "$2" > /dev/null 2>&1 || exit 1
printf '%s\n' '{"timeout":false,"tool_cpu_s":null,"tokens":null}'
EOF
pi4_ws=""
if env HOME="$FIX/home" BENCH_WS_ROOT="$FIX/ws" BENCH_SNAPSHOT_INTERVAL=1 T4_PERF_POSTINGS=20000 \
     STUB_T4_LIB="$T4B/tasks/T4/grader/lib.sh" BENCH_LLM="$tmp/llm-stub-t4" bash "$T4B/run" --agent pi \
     --model "$QWEN" --timeout 900 --task T4 --rep 1 --parts none --results "$T4R" \
     > /dev/null 2> "$FIX/pi4.err"; then
  pi4_ws="$FIX/ws/$(tail -n 1 "$T4R" | jq -r .run_id)"
fi
check "T4 pi stub: the run exits 0" test -n "$pi4_ws"
check "T4 pi stub: the series holds a periodic point at M1 = 1" \
  exits 0 jq -se 'any(.[]; .M1 == 1)' "$pi4_ws.milestones.jsonl"
check "T4 pi stub: reached = the final grade's milestones (M1, M2 of elided-sign)" \
  test "$(t4last '[.t4_milestones_reached, (.t4_milestone_t | map_values(. != null))]')" \
    = '[2,{"M1":true,"M2":true,"M3":false,"M4":false,"M5":false}]'
check "T4 pi stub: M1 is dated by the periodic point, before the run ended" \
  test "$(t4last '.t4_milestone_t.M1 < .wall_s')" = true
check "T4 pi stub: M3..M5 fell from 1.0, so at least 3 regressions" test "$(t4last '.t4_regressions >= 3')" = true
check "T4 pi stub: hidden_pass < 1 and perf_ok false (acceptance not clean)" \
  test "$(t4last '.hidden_pass < 1 and .t4_perf_ok == false')" = true
check "T4 pi stub: the snapshot directory is gone" test ! -e "$pi4_ws.snap"
# Scoped to this layout's copy, or a selftest running alongside (the flake check) would
# count; [m] keeps grep from matching its own argv.
check "T4 pi stub: no milestone checker outlives the run" \
  exits 1 grep -lsa "$T4B/tasks/T4/grader/[m]ilestones" /proc/[0-9]*/cmdline
check "T4: every row of both T4 runs validates" bash "$T4B/record" --check "$T4R"
check "report: renders a T4 table for T4 rows" bash -c '
  bash "$1/report" --runs "$2" | grep -q "^## T4: median"' _ "$BENCH" "$T4R"
check "report: no T4 table without T4 rows" bash -c '
  ! bash "$1/report" --runs "$2" | grep -q "^## T4"' _ "$BENCH" "$RESULTS"

# ---------------------------------------------------------------- prompt
for s in Boundary Termination Output; do
  check "prompt.md: has a ## $s section" grep -qi "^## *$s" "$BENCH/prompt.md"
done
check "prompt.md: exists" test -s "$BENCH/prompt.md"
check "prompt.md: names nothing outside the workspace (grep exit 1 = no match)" \
  exits 1 grep -nE '/home|~/|\.\./|autonomy|grader|wkspace' "$BENCH/prompt.md" "$BENCH"/parts/*.prompt.md

# ---------------------------------------------------------------- isolation
check "selftest never touched the real runs.jsonl" test "$(real_sum)" = "$real_before"

if [ "$pass" -eq 0 ]; then echo "selftest: no cases ran"; exit 1; fi
echo "selftest: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
