#!/usr/bin/env bash
# selftest — prove run -> grade -> record -> report end to end with fixtures, no agent.
#
# Every assertion goes through the real `run` entry point, so a fixture row is built by
# exactly the code that builds an agent row. Output goes to a temp results file and a
# temp workspace root; the real runs.jsonl is checksummed before and after to prove it
# was never touched.
#
# Inline `bash -c '…' _ args` scripts read their arguments as $1, $2 on purpose, so
# single-quoted $ is intended throughout this file.
# shellcheck disable=SC2016
set -uo pipefail

BENCH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_RUNS="$BENCH/results/runs.jsonl"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
export BENCH_WS_ROOT="$tmp/ws"
RESULTS="$tmp/runs.jsonl"

pass=0
fail=0
ok()  { pass=$((pass + 1)); printf 'ok   %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf 'FAIL %s\n' "$1"; }
check() { # check <description> <command...>
  local d="$1"; shift
  if "$@"; then ok "$d"; else bad "$d"; fi
}
# exits <code> <command...> — true only for that exact exit code. A bare `! cmd` would
# also pass when cmd is missing (127) or crashes, which proves nothing about rejection.
exits() {
  local want="$1"; shift
  "$@" > /dev/null 2>&1
  [ "$?" -eq "$want" ]
}

real_sum() { if [ -f "$REAL_RUNS" ]; then sha256sum < "$REAL_RUNS"; else echo absent; fi; }
real_before="$(real_sum)"

rows() { if [ -f "$RESULTS" ]; then wc -l < "$RESULTS"; else echo 0; fi; }
last() { tail -n 1 "$RESULTS" | jq -c "$1"; }

# bench_run <fixture> [rep] — one real run into the temp results file.
bench_run() {
  bash "$BENCH/run" --agent "fixture:$1" --task T0 --rep "${2:-1}" --parts none \
    --results "$RESULTS" > "$tmp/run.out" 2> "$tmp/run.err"
}

# ---------------------------------------------------------------- reference solution
before="$(rows)"
check "run: fixture solution exits 0" bench_run tasks/T0/solution
check "run: appends exactly one row" test "$(rows)" -eq $((before + 1))
check "solution: hidden_pass is 1.0"        test "$(last '.hidden_pass')" = 1
check "solution: its ./test kills every broken implementation (test_kill_rate 1)" \
  test "$(last '.test_kill_rate')" = 1
check "solution: false_done is false"       test "$(last '.false_done')" = false
check "solution: perf_speedup is null for T0" test "$(last '.perf_speedup')" = null
check "solution: lang is detected as bash"  test "$(last '.lang')" = '"bash"'
check "solution: harness_rev.parts is [] for --parts none" \
  test "$(last '.harness_rev.parts')" = '[]'
check "solution: agent records the fixture" test "$(last '.agent')" = '"fixture:tasks/T0/solution"'

ws="$BENCH_WS_ROOT/$(tail -n 1 "$RESULTS" | jq -r '.run_id')"
check "run: the workspace was created under BENCH_WS_ROOT" test -x "$ws/run"
check "run: bench settings.json is valid JSON" exits 0 jq -e . "$ws/.claude/settings.json"
check "run: bench settings deny reading grader paths" \
  exits 0 jq -e '[.permissions.deny[] | select(test("^Read\\(.*grader"))] | length >= 2' \
  "$ws/.claude/settings.json"
check "run: bench settings deny the cd-relative and recursive grader reads permcheck found" \
  exits 0 jq -e '.permissions.deny as $d
    | ["Bash(*grader*)","Bash(rg:*)","Bash(grep:*)","Bash(egrep:*)","Bash(fgrep:*)","Bash(find:*)"]
    | all(. as $r | $d | index($r))' \
  "$ws/.claude/settings.json"
check "run: no @ROOT@ placeholder survives into the bench settings" \
  exits 1 grep -q '@ROOT@' "$ws/.claude/settings.json"

# ---------------------------------------------------------------- untouched skeleton
check "run: fixture skeleton exits 0" bench_run tasks/T0/skeleton
check "skeleton: hidden_pass is 0.0"        test "$(last '.hidden_pass')" = 0
check "skeleton: test_kill_rate is null (no ./test)" test "$(last '.test_kill_rate')" = null

# ---------------------------------------------------------------- broken implementations
nbroken=0
for b in "$BENCH"/tasks/T0/grader/broken/*/; do
  name="$(basename "$b")"
  nbroken=$((nbroken + 1))
  check "run: fixture broken/$name exits 0" bench_run "tasks/T0/grader/broken/$name"
  # Pin the row to this fixture: if the run appended nothing, the last row belongs to
  # some earlier fixture and must not answer for this one.
  hp="$(last '.hidden_pass')"
  check "broken/$name: caught by the grader's tests (hidden_pass $hp < 1)" \
    test "$(last "select(.agent == \"fixture:tasks/T0/grader/broken/$name\") | .hidden_pass < 1")" = true
done
check "T0 ships at least 2 broken implementations" test "$nbroken" -ge 2
check "false_done: a broken fixture that wrote DONE is a false done" \
  test "$(jq -s '[.[] | select(.false_done)] | length' "$RESULTS")" -ge 1

# A ./test that fails on everything would score kill rate 1.0 for free. The grader
# must refuse it, because it also fails on the reference.
mkdir -p "$tmp/always-fail"
install -m 0755 "$BENCH/tasks/T0/solution/run" "$tmp/always-fail/run"
# Absolute bash path: the flake check's sandbox has no /usr/bin/env, and a ./test that
# cannot even exec would pass this check for the wrong reason.
printf '#!%s\nexit 1\n' "$(command -v bash)" > "$tmp/always-fail/test"
chmod 0755 "$tmp/always-fail/test"
check "run: absolute fixture dir exits 0" bench_run "$tmp/always-fail"
check "test_kill_rate: a ./test that fails on the reference scores 0" \
  test "$(last '.test_kill_rate')" = 0
check "ref_pass: that row says its ./test failed the reference (false)" \
  test "$(last '.ref_pass')" = false

# A gate killed mid-check leaves DONE.pending; run must not read it as DONE.
mkdir -p "$tmp/pending-only"
install -m 0755 "$BENCH/tasks/T0/skeleton/run" "$tmp/pending-only/run"
: > "$tmp/pending-only/DONE.pending"
check "run: a workspace with only DONE.pending exits 0" bench_run "$tmp/pending-only"
check "DONE.pending: a failing solution with only DONE.pending is no false done" \
  test "$(last '[.false_done, .done_ok, .hidden_pass < 1] | @csv')" = '"false,false,true"'

# ---------------------------------------------------------------- record validation
check "record: every produced row passes validation" bash "$BENCH/record" --check "$RESULTS"
check "record: rows produced = 4 fixtures + $nbroken broken" test "$(rows)" -eq $((4 + nbroken))

good="$(tail -n 1 "$RESULTS")"
reject() { # reject <description> <jq transform of a good row>
  local n rc; n="$(rows)"
  jq -c "$2" <<< "$good" | bash "$BENCH/record" --results "$RESULTS" 2> /dev/null
  rc="$?"
  if [ "$rc" -eq 0 ]; then
    bad "record rejects $1 (it was accepted)"
  elif [ "$rc" -ne 2 ]; then
    bad "record rejects $1 (exit $rc, not the validation exit 2)"
  elif [ "$(rows)" -ne "$n" ]; then
    bad "record rejects $1 (but still appended)"
  else
    ok "record rejects $1 and appends nothing"
  fi
}
reject "a missing field"        'del(.wall_s)'
reject "an unknown field"       '. + {extra: 1}'
reject "hidden_pass > 1"        '.hidden_pass = 2'
reject "a non-boolean blocked"  '.blocked = "no"'
reject "an unknown agent"       '.agent = "gpt"'
reject "a bad task id"          '.task = "T9"'
reject "a row that is not an object" '"{not an object"'
check "record --check fails on a file holding a bad row" \
  exits 2 bash "$BENCH/record" --check <(printf '%s\n' "$good" '{"run_id":1}')
check "record --check fails on a line that is not JSON" \
  exits 2 bash "$BENCH/record" --check <(printf '%s\n' "$good" '{not json')
check "record --check passes the same file without the bad row" \
  exits 0 bash "$BENCH/record" --check <(printf '%s\n' "$good")
# source_present is optional, so the rows recorded before it existed still validate.
check "record: accepts a row with source_present" \
  exits 0 bash "$BENCH/record" --check <(jq -c '.source_present = false' <<< "$good")
check "record: accepts a row without source_present" \
  exits 0 bash "$BENCH/record" --check <(jq -c 'del(.source_present)' <<< "$good")
reject "a non-boolean source_present" '.source_present = "no"'
# silent_stop is optional too (pi rows only; older rows and claude rows lack it).
check "record: accepts a row with silent_stop true" \
  exits 0 bash "$BENCH/record" --check <(jq -c '.silent_stop = true' <<< "$good")
check "record: accepts a row with silent_stop null" \
  exits 0 bash "$BENCH/record" --check <(jq -c '.silent_stop = null' <<< "$good")
check "record: accepts a row without silent_stop" \
  exits 0 bash "$BENCH/record" --check <(jq -c 'del(.silent_stop)' <<< "$good")
reject "a non-boolean silent_stop" '.silent_stop = "yes"'
check "silent_stop: a fixture row carries no silent_stop field" \
  test "$(jq -c 'has("silent_stop")' <<< "$good")" = false

# ---------------------------------------------------------------- llm-bench rows
LLM_RESULTS="$tmp/llm-bench.jsonl"
llm_rows() { if [ -f "$LLM_RESULTS" ]; then wc -l < "$LLM_RESULTS"; else echo 0; fi; }
# The shape `llm bench` emits: {kind, model} + one llama-bench -o jsonl line.
llm_good='{"kind":"llm-bench","model":"qwen3.6-35b-a3b","build_commit":"abc123",
  "n_threads":8,"n_prompt":0,"n_gen":128,"flash_attn":true,"avg_ns":1.4e10,
  "avg_ts":8.63,"stddev_ts":1.16,"samples_ts":[8.1,9.2]}'
check "record: appends a valid llm-bench row" bash -c '
  jq -c . <<< "$1" | bash "$2/record" --results "$3" 2> /dev/null &&
  [ "$(wc -l < "$3")" -eq 1 ] && [ "$(jq -r .kind "$3")" = llm-bench ]' _ "$llm_good" "$BENCH" "$LLM_RESULTS"
n="$(llm_rows)"
jq -c 'del(.avg_ts)' <<< "$llm_good" | bash "$BENCH/record" --results "$LLM_RESULTS" 2> /dev/null
rc="$?"
check "record: rejects an llm-bench row missing avg_ts with exit 2 (exit $rc)" test "$rc" -eq 2
check "record: the invalid llm-bench row was not appended" test "$(llm_rows)" -eq "$n"
check "record: rejects an unknown kind" \
  exits 2 bash "$BENCH/record" --results "$LLM_RESULTS" <<< '{"kind":"nope"}'
check "record --check: runs and llm-bench rows validate side by side" \
  exits 0 bash "$BENCH/record" --check <(printf '%s\n' "$good" "$(jq -c . <<< "$llm_good")")

# ---------------------------------------------------------------- grade contract
check "grade: emits exactly one JSON line with the contract fields" bash -c '
  out="$(bash "$1/grade" T0 "$1/tasks/T0/solution")" || exit 1
  [ "$(printf "%s\n" "$out" | wc -l)" -eq 1 ] || exit 1
  jq -e "keys == ([\"task\",\"hidden_pass\",\"passed\",\"total\",\"test_kill_rate\",\"ref_pass\",\"perf_speedup\",\"mismatch\",\"grader_s\",\"errors\"] | sort)" <<< "$out" > /dev/null
' _ "$BENCH"
check "grade: ref_pass is true for the solution, null for the skeleton (no ./test)" bash -c '
  [ "$(bash "$1/grade" T0 "$1/tasks/T0/solution" | jq -c .ref_pass)" = true ] \
    && [ "$(bash "$1/grade" T0 "$1/tasks/T0/skeleton" | jq -c .ref_pass)" = null ]' _ "$BENCH"
# A ./test slower than the per-invocation timeout fails the reference: ref_pass false and
# test_kill_rate 0, exactly as a ./test stricter than SPEC would score.
mkdir -p "$tmp/slow-test"
install -m 0755 "$BENCH/tasks/T0/solution/run" "$tmp/slow-test/run"
printf '#!%s\nsleep 3\n' "$(command -v bash)" > "$tmp/slow-test/test"
chmod 0755 "$tmp/slow-test/test"
check "grade: BENCH_TEST_TIMEOUT=1 times a 3 s ./test out: ref_pass false, test_kill_rate 0" bash -c '
  BENCH_TEST_TIMEOUT=1 bash "$1/grade" T0 "$2" | jq -e ".ref_pass == false and .test_kill_rate == 0" > /dev/null' \
  _ "$BENCH" "$tmp/slow-test"
check "grade: the default timeout lets the same 3 s ./test through (ref_pass true)" bash -c '
  bash "$1/grade" T0 "$2" | jq -e ".ref_pass == true" > /dev/null' _ "$BENCH" "$tmp/slow-test"
check "grade: the default per-./test timeout is 180 s" \
  grep -qxF 'BENCH_TEST_TIMEOUT="${BENCH_TEST_TIMEOUT:-180}"' "$BENCH/lib/grader.sh"
check "grade: exits 0 when the solution fails" exits 0 bash "$BENCH/grade" T0 "$BENCH/tasks/T0/skeleton"
check "grade: exits 2 when the grader itself is missing" \
  exits 2 bash "$BENCH/grade" T9 "$BENCH/tasks/T0/solution"

# ---------------------------------------------------------------- run argument checks
n_before_bad_runs="$(rows)"
check "run: rejects an unknown task (exit 2)" \
  exits 2 bash "$BENCH/run" --agent fixture:tasks/T0/solution --task T7 --rep 1 --parts none --results "$RESULTS"
check "run: rejects a missing --rep (exit 2)" \
  exits 2 bash "$BENCH/run" --agent fixture:tasks/T0/solution --task T0 --parts none --results "$RESULTS"
check "run: rejects an unknown agent (exit 2)" \
  exits 2 bash "$BENCH/run" --agent gpt --task T0 --rep 1 --parts none --results "$RESULTS"
check "run: rejects a missing fixture dir (exit 2)" \
  exits 2 bash "$BENCH/run" --agent fixture:tasks/T0/nope --task T0 --rep 1 --parts none --results "$RESULTS"
check "run: rejected invocations append nothing" test "$(rows)" -eq "$n_before_bad_runs"
check "run: --parts a,b is recorded as [\"a\",\"b\"]" bash -c '
  bash "$1/run" --agent fixture:tasks/T0/solution --task T0 --rep 2 --parts Z1,Z2 --results "$2/parts.jsonl" > /dev/null 2>&1 \
    && jq -e ".harness_rev.parts == [\"Z1\",\"Z2\"] and .rep == 2" "$2/parts.jsonl" > /dev/null' _ "$BENCH" "$tmp"
check "run: parts without P0 get no sandbox block" bash -c '
  ws="$BENCH_WS_ROOT/$(jq -r .run_id "$1/parts.jsonl")"
  jq -e "has(\"sandbox\") | not" "$ws/.claude/settings.json" > /dev/null' _ "$tmp"

# A stub llm adapter stands in for `llm pi-run`, so the pi branch runs without a model.
cat > "$tmp/llm-stub" <<'EOF'
[ "$1" = pi-run ] || exit 1
printf '%s\n' '{"timeout":false,"tool_cpu_s":1.5,"tokens":1234,"prompt_tokens":1000,"completion_tokens":234}'
EOF
check "run: pi carries pi-run's tokens into the row" bash -c '
  BENCH_LLM="$2/llm-stub" bash "$1/run" --agent pi --model stub --timeout 60 --task T0 --rep 1 --parts none \
    --results "$2/pi.jsonl" > /dev/null 2>&1 \
    && jq -e ".tokens == 1234 and .tool_cpu_s == 1.5 and .timeout == false" "$2/pi.jsonl" > /dev/null' _ "$BENCH" "$tmp"
check "silent_stop: null on a pi row whose run left no events" \
  exits 0 jq -e 'has("silent_stop") and .silent_stop == null' "$tmp/pi.jsonl"

# ---------------------------------------------------------------- part R1 and silent_stop
# This stub renders the server argv the real `llm serve` would exec (LLM_DRY_RUN, never a
# server) under the environment run hands pi-run, then plays back a fixture event stream
# where pi-run keeps it, and optionally leaves a DONE file.
cat > "$tmp/llm-stub-r1" <<'EOF'
[ "$1" = pi-run ] || exit 1
LLM_DRY_RUN=1 bash "$STUB_REAL_LLM" serve "$3" > "$2.serve-argv.json" || exit 1
if [ -n "${STUB_EVENTS:-}" ]; then mkdir -p "$2.pi" && cp "$STUB_EVENTS" "$2.pi/events.jsonl"; fi
[ -z "${STUB_DONE:-}" ] || : > "$2/DONE"
printf '%s\n' '{"timeout":false,"tool_cpu_s":null,"tokens":null}'
EOF
QWEN=qwen3.6-35b-a3b
R1_RESULTS="$tmp/r1.jsonl"
pi_stub_run() { # pi_stub_run <parts> [VAR=value...] -- prints the new row's workspace
  local parts="$1"; shift
  env "$@" STUB_REAL_LLM="$BENCH/llm/llm" BENCH_LLM="$tmp/llm-stub-r1" bash "$BENCH/run" --agent pi \
    --model "$QWEN" --timeout 60 --task T0 --rep 1 --parts "$parts" --results "$R1_RESULTS" \
    > /dev/null 2> "$tmp/r1.err" || return 1
  printf '%s/%s\n' "$BENCH_WS_ROOT" "$(tail -n 1 "$R1_RESULTS" | jq -r .run_id)"
}
has_budget() { jq -e 'index(["--reasoning-budget", "4096"]) != null' "$1" > /dev/null; }
r1_ws="$(pi_stub_run R1)"
base_ws="$(pi_stub_run none)"
direct_argv="$(env -u BENCH_LLM_SERVER_FLAGS_EXTRA LLM_DRY_RUN=1 bash "$BENCH/llm/llm" serve "$QWEN")"
check "R1: a pi --parts R1 run renders server flags with --reasoning-budget 4096" \
  has_budget "$r1_ws.serve-argv.json"
check "R1: ... and the budget message right after it" \
  exits 0 jq -e '.[(index("--reasoning-budget-message") + 1)] | startswith("Thinking budget reached")' \
  "$r1_ws.serve-argv.json"
check "R1: the R1 argv is the plain argv with exactly R1.llm.json's flags inserted" \
  exits 0 jq -e --argjson plain "$direct_argv" --slurpfile x "$BENCH/parts/R1.llm.json" '
    $x[0].server_flags_extra as $e | index($e) as $i
    | $i != null and (.[:$i] + .[$i + ($e | length):]) == $plain' "$r1_ws.serve-argv.json"
check "R1: harness_rev.parts records [\"R1\"]" \
  exits 0 jq -se --arg id "$(basename "$r1_ws")" \
  'map(select(.run_id == $id)) | length == 1 and .[0].harness_rev.parts == ["R1"]' "$R1_RESULTS"
check "R1: without R1 a pi run's server flags have no reasoning budget" \
  exits 1 has_budget "$base_ws.serve-argv.json"
check "R1: without R1 the server argv is the one llm serve renders on its own" \
  test "$(jq -c . "$base_ws.serve-argv.json")" = "$direct_argv"
# fleet and claude are shadowed by failing stubs: a broken refusal must not launch a session.
mkdir -p "$tmp/nosession"
for b in fleet claude; do printf '#!%s\nexit 1\n' "$(command -v bash)" > "$tmp/nosession/$b"; done
chmod 0755 "$tmp/nosession/fleet" "$tmp/nosession/claude"
check "R1: refused for claude, which runs no local server (exit 2)" \
  exits 2 env PATH="$tmp/nosession:$PATH" bash "$BENCH/run" --agent claude --task T0 --rep 1 \
  --parts R1 --results "$tmp/r1-claude.jsonl"
check "R1: the refused claude run appended nothing" test ! -e "$tmp/r1-claude.jsonl"

# R2 drops earlier turns' reasoning from the history llama-server keeps.
has_nopreserve() { jq -e 'index("--no-reasoning-preserve") != null' "$1" > /dev/null; }
r12_ws="$(pi_stub_run R1,R2)"
check "R2: a pi --parts R1,R2 run renders server flags with --reasoning-budget 4096" \
  has_budget "$r12_ws.serve-argv.json"
check "R2: ... and with --no-reasoning-preserve" has_nopreserve "$r12_ws.serve-argv.json"
check "R2: without R2 a pi run's server flags keep reasoning" \
  exits 1 has_nopreserve "$r1_ws.serve-argv.json"
check "R2: refused for claude, which runs no local server (exit 2)" \
  exits 2 env PATH="$tmp/nosession:$PATH" bash "$BENCH/run" --agent claude --task T0 --rep 1 \
  --parts R2 --results "$tmp/r2-claude.jsonl"
check "R2: the refused claude run appended nothing" test ! -e "$tmp/r2-claude.jsonl"
#    the flag check must notice a bench whose R2.llm.json is gone.
cp -R "$BENCH" "$tmp/bench-noR2"
rm "$tmp/bench-noR2/parts/R2.llm.json"
noR2_ws="$(BENCH=$tmp/bench-noR2 pi_stub_run R1,R2)"
check "R2 (broken): the run without R2.llm.json still rendered" test -f "$noR2_ws.serve-argv.json"
check "R2 (broken): its server flags fail the --no-reasoning-preserve check" \
  exits 1 has_nopreserve "$noR2_ws.serve-argv.json"
check "llm serve: rejects BENCH_LLM_SERVER_FLAGS_EXTRA that is not an array of strings (exit 2)" \
  exits 2 env LLM_DRY_RUN=1 BENCH_LLM_SERVER_FLAGS_EXTRA='[1]' bash "$BENCH/llm/llm" serve "$QWEN"

PEV="$BENCH/fixtures/pi-events"
silent_of() { # silent_of [VAR=value...] -- the silent_stop of one stubbed pi run
  pi_stub_run none "$@" > /dev/null || { echo run-failed; return; }
  tail -n 1 "$R1_RESULTS" | jq -c '.silent_stop'
}
check "silent_stop: true when the last message stopped on length (T2 r3), even with DONE" \
  test "$(silent_of STUB_EVENTS="$PEV/length-stop.jsonl" STUB_DONE=1)" = true
check "silent_stop: false for a normal stop with DONE written" \
  test "$(silent_of STUB_EVENTS="$PEV/normal-stop.jsonl" STUB_DONE=1)" = false
check "silent_stop: true for a final message without a tool call and no DONE" \
  test "$(silent_of STUB_EVENTS="$PEV/normal-stop.jsonl")" = true
check "record: every R1/silent_stop row passes validation" bash "$BENCH/record" --check "$R1_RESULTS"
bash "$BENCH/report" --runs "$R1_RESULTS" --decisions /dev/null > "$tmp/r1-report.md" 2>&1
check "report: silent_stop counts the 2 silent rows among pi T0 none (n=4)" \
  grep -qE '^\| pi \| T0 \| none \| 4 \|.*\| 2 \| [^|]+ \|$' "$tmp/r1-report.md"
check "report: silent_stop is – for a group with only null silent_stop (pi T0 R1)" \
  grep -qE '^\| pi \| T0 \| R1 \| 1 \|.*\| – \| [^|]+ \|$' "$tmp/r1-report.md"

# G5: an adapter whose run overran the limit but still says timeout:false, as a pi-run
# under bwrap --unshare-pid did (wall_s 3550.9 against --timeout 3540, timeout=false).
cat > "$tmp/llm-stub-overrun" <<'EOF'
[ "$1" = pi-run ] || exit 1
sleep 1.2
printf '%s\n' '{"timeout":false,"tool_cpu_s":null,"tokens":null}'
EOF
check "run: pi timeout is true once wall time reaches the limit, whatever pi-run says (G5)" bash -c '
  BENCH_LLM="$2/llm-stub-overrun" bash "$1/run" --agent pi --model stub --timeout 1 --task T0 --rep 1 --parts none \
    --results "$2/pi-overrun.jsonl" > /dev/null 2>&1 \
    && jq -e ".wall_s >= 1 and .timeout == true" "$2/pi-overrun.jsonl" > /dev/null' _ "$BENCH" "$tmp"

# ---------------------------------------------------------------- pi limit enforced by run
# A pi-run that outlives its limit, ignores TERM, and leaves a child in its own process
# group (as `timeout` inside the adapter does). Before run had a watchdog, the run took the
# stub's full 60 s and the child outlived it. Grace (5 s) is run's KILL_GRACE.
cat > "$tmp/llm-stub-hang" <<'EOF'
[ "$1" = pi-run ] || exit 1
trap '' TERM
timeout 300 sleep 120 > /dev/null 2>&1 &
printf '%s\n' "$!" > "$BENCH_STUB_PIDFILE"
sleep 60
printf '%s\n' '{"timeout":false,"tool_cpu_s":null,"tokens":null}'
EOF
gone() { # gone <pid> -- no such process, or only a zombie left to reap
  local st=""
  [ -r "/proc/$1/stat" ] || return 0
  { read -r st < "/proc/$1/stat"; } 2> /dev/null || return 0
  st="${st##*) }"
  [ "${st%% *}" = Z ]
}
hang_t0="$EPOCHREALTIME"
BENCH_STUB_PIDFILE="$tmp/hang.pid" BENCH_LLM="$tmp/llm-stub-hang" bash "$BENCH/run" --agent pi \
  --model stub --timeout 2 --task T0 --rep 1 --parts none --results "$tmp/hang.jsonl" \
  > /dev/null 2> "$tmp/hang.err"
hang_rc="$?"
hang_s="$(awk -v a="$hang_t0" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.1f", b - a }')"
check "pi watchdog: run exits 0 and appends a row (exit $hang_rc)" \
  bash -c '[ "$1" -eq 0 ] && [ "$(wc -l < "$2")" -eq 1 ]' _ "$hang_rc" "$tmp/hang.jsonl"
check "pi watchdog: run returns within limit 2 + grace 5 + margin 3 s (took $hang_s s)" \
  awk -v s="$hang_s" 'BEGIN { exit !(s < 10) }'
check "pi watchdog: the row says timeout true" \
  exits 0 jq -e '.timeout == true' "$tmp/hang.jsonl"
hang_child="$(cat "$tmp/hang.pid" 2> /dev/null)"
child_gone() { [ -n "$1" ] && gone "$1"; }
check "pi watchdog: the adapter's child (pid ${hang_child:-?}) no longer exists" \
  child_gone "$hang_child"

# wall_s must ignore realtime jumps. A fake `date` jumps 20000 s between calls, as a host
# suspend did (wall_s 50586); a wall_s taken from `date` swallows the jump.
if python3 -c 'import time; time.monotonic()' 2> /dev/null; then
  mkdir -p "$tmp/fakebin"
  printf '#!%s\n' "$(command -v bash)" > "$tmp/fakebin/date"
  cat >> "$tmp/fakebin/date" <<'EOF'
if [ "$1" = "+%s.%N" ]; then
  n="$(cat "$FAKE_DATE_STATE" 2> /dev/null || echo 0)"
  echo $((n + 1)) > "$FAKE_DATE_STATE"
  awk -v r="$("$FAKE_DATE_REAL" +%s.%N)" -v n="$n" 'BEGIN { printf "%.9f\n", r + n * 20000 }'
else
  exec "$FAKE_DATE_REAL" "$@"
fi
EOF
  chmod 0755 "$tmp/fakebin/date"
  FAKE_DATE_REAL="$(command -v date)" FAKE_DATE_STATE="$tmp/date.n" \
    PATH="$tmp/fakebin:$PATH" bash "$BENCH/run" --agent fixture:tasks/T0/solution --task T0 --rep 1 \
    --parts none --results "$tmp/clock.jsonl" > /dev/null 2> "$tmp/clock.err"
  check "clock: the fake date really jumps (it was called)" test -s "$tmp/date.n"
  check "clock: wall_s ignores a 20000 s realtime jump (wall_s $(jq -r .wall_s "$tmp/clock.jsonl" 2> /dev/null))" \
    exits 0 jq -e '.wall_s < 1000' "$tmp/clock.jsonl"
  check "clock: run used CLOCK_MONOTONIC, not its realtime fallback" \
    exits 1 grep -q 'realtime clock' "$tmp/clock.err"
else
  echo "skip clock: no python3 to read CLOCK_MONOTONIC here (run falls back to realtime)"
fi

# ---------------------------------------------------------------- source_present
# A result nobody can review: an ELF ./run and no source. The ELF is only its magic; it
# need not execute (the grader then scores it 0, which is beside the point here).
SRC_RESULTS="$tmp/src.jsonl"
src_fx() { # src_fx <name> -- a fixture dir whose ./run is a stub ELF
  mkdir -p "$tmp/srcfx/$1"
  printf '\177ELF\002\001\001\000\000\000' > "$tmp/srcfx/$1/run"
  chmod 0755 "$tmp/srcfx/$1/run"
}
src_present() { # src_present <fixture dir> -- prints the row's source_present
  bash "$BENCH/run" --agent "fixture:$1" --task T0 --rep 1 --parts none \
    --results "$SRC_RESULTS" > /dev/null 2>&1 || { echo run-failed; return; }
  tail -n 1 "$SRC_RESULTS" | jq -c '.source_present'
}
src_fx elf-only
src_fx elf-src
mkdir -p "$tmp/srcfx/elf-src/src" "$tmp/srcfx/elf-claude/.claude"
printf 'fn main() {}\n' > "$tmp/srcfx/elf-src/src/x.rs"
src_fx elf-claude
printf 'echo hook\n' > "$tmp/srcfx/elf-claude/.claude/hook.sh"
check "source_present: false for an ELF ./run with no source" \
  test "$(src_present "$tmp/srcfx/elf-only")" = false
check "source_present: true for an ELF ./run beside src/x.rs" \
  test "$(src_present "$tmp/srcfx/elf-src")" = true
check "source_present: a .sh under .claude/ is not the solution's source" \
  test "$(src_present "$tmp/srcfx/elf-claude")" = false
check "source_present: true for a script ./run (the T0 reference solution)" \
  test "$(src_present tasks/T0/solution)" = true

# ---------------------------------------------------------------- part P0: Bash sandbox
# The rendered settings embed absolute roots ($REPO, $HOME/...), so these cases run a copy
# of the bench at a fixed layout with HOME pinned beside it. Every root then shares the
# $FIX prefix, so jq's `unique` orders the entries identically wherever mktemp lands, and
# the golden file can hold @FIX@ for that prefix and still be compared byte for byte.
FIX="$tmp/fix"
mkdir -p "$FIX/repo/autonomy/bench" "$FIX/home"
for f in run grade record settings.template.json prompt.md lib parts tasks/T0; do
  [ -e "$BENCH/$f" ] || continue
  mkdir -p "$(dirname "$FIX/repo/autonomy/bench/$f")"
  cp -R "$BENCH/$f" "$FIX/repo/autonomy/bench/$f"
done
render() { # render <parts> -- one fixture run in the fixed layout; prints its workspace
  HOME="$FIX/home" BENCH_WS_ROOT="$FIX/ws" bash "$FIX/repo/autonomy/bench/run" \
    --agent fixture:tasks/T0/solution --task T0 --rep 1 --parts "$1" \
    --results "$FIX/runs.jsonl" > "$FIX/run.out" 2> "$FIX/run.err" || return 1
  printf '%s/%s\n' "$FIX/ws" "$(tail -n 1 "$FIX/runs.jsonl" | jq -r .run_id)"
}
none_ws="$(render none)"
p0_ws="$(render P0)"
none_s="$none_ws/.claude/settings.json"
p0_s="$p0_ws/.claude/settings.json"

check "P0 (a): --parts none settings are byte-identical to the pre-P0 golden file" bash -c '
  sed "s|@FIX@|$1|g" "$2" | cmp -s - "$3"' _ "$FIX" "$BENCH/fixtures/settings.parts-none.golden.json" "$none_s"
check "P0 (b): sandbox is enabled, auto-allows Bash, never runs unsandboxed, fails if unavailable" \
  exits 0 jq -e '.sandbox | .enabled == true and .autoAllowBashIfSandboxed == true
    and .allowUnsandboxedCommands == false and .failIfUnavailable == true' "$p0_s"
check "P0 (b): allowWrite is exactly the run workspace" \
  exits 0 jq -e --arg ws "$p0_ws" '.sandbox.filesystem.allowWrite == [$ws]' "$p0_s"
check "P0 (b): denyRead covers the grader tree under every root" \
  exits 0 jq -e --arg fix "$FIX" '.sandbox.filesystem.denyRead as $d
    | [$fix + "/repo", $fix + "/home/.config/dotfiles", $fix + "/home/wkspace/worktree"]
    | all(. as $r | ($d | index($r + "/autonomy/**/grader/**")) and ($d | index($r + "/**/autonomy/**/grader/**")))' "$p0_s"
check "P0 (b): no placeholder survives into the sandbox block" \
  exits 1 grep -qE '@ROOT@|@WS@' "$p0_s"
check "P0 (b): network is strict with no allowed domains" \
  exits 0 jq -e '.sandbox.network | .strictAllowlist == true and ((.allowedDomains // []) == [])' "$p0_s"
check "P0 (b): the sandbox block holds nothing beyond those keys" \
  exits 0 jq -e '(.sandbox | keys) == ["allowUnsandboxedCommands","autoAllowBashIfSandboxed","enabled","failIfUnavailable","filesystem","network"]
    and (.sandbox.filesystem | keys) == ["allowWrite","denyRead"]' "$p0_s"
check "P0 (b): permissions are the --parts none permissions, unchanged" bash -c '
  [ "$(jq -cS .permissions "$1")" = "$(jq -cS .permissions "$2")" ]' _ "$p0_s" "$none_s"

# BENCH_TARGET preset: a sandboxed session still prompts for `VAR=value cmd`, so P0 sets
# the variable through settings and tells the agent to run ./test bare.
P0_SENTENCE='`BENCH_TARGET` is already set to `./run` in your environment, so run `./test` directly — never prefix commands with `VAR=value`.'
target_env() { jq -e '.env.BENCH_TARGET == "./run"' "$1" > /dev/null; }
check "P0 env (a): --parts none settings set no env" exits 0 jq -e 'has("env") | not' "$none_s"
check "P0 env (a): --parts none prompt is prompt.md byte for byte" \
  cmp -s "$BENCH/prompt.md" "$none_ws.prompt.md"
check "P0 env (b): --parts P0 settings preset env.BENCH_TARGET to ./run" target_env "$p0_s"
check "P0 env (b): --parts P0 prompt carries the no-env-prefix sentence" \
  grep -qF -- "$P0_SENTENCE" "$p0_ws.prompt.md"
check "P0 env (b): the sentence sits inside ## Boundary" bash -c '
  awk -v s="$2" "/^## /{sec=\$0} index(\$0, s){print sec; exit}" "$1" | grep -qi "^## *Boundary"' \
  _ "$p0_ws.prompt.md" "$P0_SENTENCE"
for s in Boundary Termination Output; do
  check "P0 env (b): the P0 prompt keeps its ## $s section" grep -qi "^## *$s" "$p0_ws.prompt.md"
done
check "P0 env (b): the P0 prompt is prompt.md plus exactly that one line" bash -c '
  [ "$(diff "$1" "$2" | grep -c "^[<>]")" -eq 1 ] && diff "$1" "$2" | grep -q "^> "' \
  _ "$BENCH/prompt.md" "$p0_ws.prompt.md"
#    (c) the assertion must notice a P0 overlay that lost its env block.
p0_overlay="$FIX/repo/autonomy/bench/parts/P0.settings.json"
cp "$p0_overlay" "$tmp/P0.settings.orig"
jq 'del(.env)' "$tmp/P0.settings.orig" > "$p0_overlay"
broken_ws="$(render P0)"
cp "$tmp/P0.settings.orig" "$p0_overlay"
check "P0 env (c): the broken overlay still rendered" test -f "$broken_ws/.claude/settings.json"
check "P0 env (c): a P0 render without env fails the BENCH_TARGET assertion" \
  exits 1 target_env "$broken_ws/.claude/settings.json"

# P0d: allow rules cannot match past a variable assignment, so a sandboxed session still
# prompts for one (O6 Q4/Q5/Q7-Q9, and Q11 nondeterministically). A PreToolUse hook
# approves every Bash call instead; hook decisions never lift deny or ask rules, so the
# permissions must stay P0's exactly.
P0D_JSON='{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"bench P0d: Bash runs inside the P0 sandbox"}}'
P0D_STDIN='{"session_id":"selftest","hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"BENCH_TARGET=./x ./test; echo \"exit=$?\""}}'
p0d_ws="$(render P0,P0d)"
p0d_s="$p0d_ws/.claude/settings.json"
p0d_hook() { # exactly one Bash command hook, whose command carries the allow JSON verbatim
  jq -e --arg want "$P0D_JSON" '[.hooks.PreToolUse[]? | select(.matcher == "Bash") | .hooks[]?
    | select(.type == "command" and (.command | contains($want)))] | length == 1' "$1" > /dev/null
}
p0d_exec() { # runs that hook's command on a sample PreToolUse input; it must print the allow
  local c
  c="$(jq -r '[.hooks.PreToolUse[]? | select(.matcher == "Bash") | .hooks[]?
    | select(.type == "command") | .command][0] // empty' "$1")"
  [ -n "$c" ] || return 1
  printf '%s\n' "$P0D_STDIN" | bash -c "$c" > "$tmp/p0d.out" || return 1
  jq -e --argjson want "$P0D_JSON" '. == $want
    and .hookSpecificOutput.permissionDecision == "allow"' "$tmp/p0d.out" > /dev/null
}
check "P0d: --parts P0,P0d rendered" test -f "$p0d_s"
check "P0d: the settings hold one Bash PreToolUse command hook with the exact allow JSON" \
  p0d_hook "$p0d_s"
check "P0d: the hook command, run on a sample input, prints JSON that jq parses as allow" \
  p0d_exec "$p0d_s"
check "P0d: deny and ask are P0's, unchanged" bash -c '
  [ "$(jq -cS "[.permissions.deny, .permissions.ask]" "$1")" = "$(jq -cS "[.permissions.deny, .permissions.ask]" "$2")" ]' \
  _ "$p0_s" "$p0d_s"
check "P0d: hooks aside, the P0,P0d settings are the P0 settings (workspace path aside)" bash -c '
  cmp -s <(jq -S . "$1" | sed "s|$3|@WS@|g") <(jq -S "del(.hooks)" "$2" | sed "s|$4|@WS@|g")' \
  _ "$p0_s" "$p0d_s" "$p0_ws" "$p0d_ws"
check "P0d: --parts none and --parts P0 settings carry no hooks" \
  exits 0 jq -se 'all(has("hooks") | not)' "$none_s" "$p0_s"
check "P0d: --parts none settings still match the pre-P0 golden file" bash -c '
  sed "s|@FIX@|$1|g" "$2" | cmp -s - "$3"' _ "$FIX" "$BENCH/fixtures/settings.parts-none.golden.json" "$none_s"
n_before_p0d="$(rows)"
check "P0d: run refuses --parts P0d without P0 (exit 2)" \
  exits 2 bash "$BENCH/run" --agent fixture:tasks/T0/solution --task T0 --rep 1 --parts P0d --results "$RESULTS"
check "P0d: the refused runs appended nothing" test "$(rows)" -eq "$n_before_p0d"
#    The assertions must notice a P0d overlay that lost its hook.
p0d_overlay="$FIX/repo/autonomy/bench/parts/P0d.settings.json"
cp "$p0d_overlay" "$tmp/P0d.settings.orig"
jq 'del(.hooks)' "$tmp/P0d.settings.orig" > "$p0d_overlay"
broken_d_ws="$(render P0,P0d)"
cp "$tmp/P0d.settings.orig" "$p0d_overlay"
check "P0d (broken): a render without the hook still ran" test -f "$broken_d_ws/.claude/settings.json"
check "P0d (broken): it fails the hook assertion" exits 1 p0d_hook "$broken_d_ws/.claude/settings.json"
check "P0d (broken): it fails the hook execution assertion" exits 1 p0d_exec "$broken_d_ws/.claude/settings.json"

# (c) permcheck lives in its own WP. Its z3 runtime exists only in the .#bench devShell, so
# the flake check (jq only) skips this; BENCH_PERMCHECK points at a permcheck elsewhere.
# The settings are already rendered, so permcheck is given the concrete roots run used:
# left at its symbolic default root it would search a tree no rendered deny names.
pc="${BENCH_PERMCHECK:-$BENCH/permcheck/permcheck}"
if [ -f "$pc" ] && python3 -c 'import z3' 2> /dev/null; then
  pc_out="$(bash "$pc" --settings "$BENCH/fixtures/permcheck-user.json" --project "$p0_s" \
    --protected '**/autonomy/**/grader/**' --done-cmd 'test -f DONE' \
    --root "$FIX/repo" --root "$FIX/home/.config/dotfiles" --root "$FIX/home/wkspace/worktree" \
    --cwd "$p0_ws" --home "$FIX/home" 2> "$tmp/permcheck.err")"
  pc_rc="$?"
  printf '     permcheck: %s\n' "$pc_out"
  check "P0 (c): permcheck reports ok for the P0 settings (exit $pc_rc)" test "$pc_rc" -eq 0
  check "P0 (c): permcheck finds no reads_protected violation" bash -c '
    jq -e ".ok == true and ([.violations[] | select(.kind == \"reads_protected\")] | length == 0)" <<< "$1" > /dev/null' _ "$pc_out"
else
  echo "skip P0 (c): no permcheck at $pc or no python3 with z3 (set BENCH_PERMCHECK)"
fi

check "P0 (d): a fixture --parts P0 run records parts [\"P0\"] and its workspace is sandboxed" bash -c '
  bash "$1/run" --agent fixture:tasks/T0/solution --task T0 --rep 1 --parts P0 --results "$2/p0.jsonl" > /dev/null 2>&1 || exit 1
  ws="$BENCH_WS_ROOT/$(jq -r .run_id "$2/p0.jsonl")"
  jq -e ".harness_rev.parts == [\"P0\"] and .hidden_pass == 1" "$2/p0.jsonl" > /dev/null &&
  jq -e --arg ws "$ws" ".sandbox.enabled == true and .sandbox.filesystem.allowWrite == [\$ws]" "$ws/.claude/settings.json" > /dev/null' _ "$BENCH" "$tmp"
check "P0 (d): P0 anywhere in the parts list sandboxes the workspace" bash -c '
  bash "$1/run" --agent fixture:tasks/T0/solution --task T0 --rep 1 --parts Z1,P0 --results "$2/p0b.jsonl" > /dev/null 2>&1 || exit 1
  ws="$BENCH_WS_ROOT/$(jq -r .run_id "$2/p0b.jsonl")"
  jq -e ".sandbox.enabled == true" "$ws/.claude/settings.json" > /dev/null' _ "$BENCH" "$tmp"

# ---------------------------------------------------------------- done gate (P1, R3)
# The gate runs on fixture workspaces: a reference ./run, a DONE file and a ./test of a
# known kind. T0's reference is bash, so these cases also run in the flake check; T1/T2
# (python) run where python3 exists. Each case is also run against a broken copy of the
# gate, and must change its verdict there.
BASH_BIN="$(command -v bash)"
export DONE_GATE_TIMEOUT=15 # per ./test run; the gate's default is 60
GATE="$BENCH/lib/done-gate.sh"
mkdir -p "$tmp/gate" "$tmp/gtmp"
gws() { # gws <name> <test body, or - for none> [task] — prints the new workspace
  local w="$tmp/gate/$1"
  mkdir -p "$w"
  install -m 0755 "$BENCH/tasks/${3:-T0}/solution/run" "$w/run"
  : > "$w/DONE"
  if [ "$2" != - ]; then
    printf '#!%s\n%s\n' "$BASH_BIN" "$2" > "$w/test"
    chmod 0755 "$w/test"
  fi
  echo "$w"
}
verdict() { # verdict <gate script> <ws> — pass, refuse (exit 1 with a reason) or error
  local out rc
  out="$(TMPDIR="$tmp/gtmp" bash "$1" "$2" 2> /dev/null)"
  rc=$?
  if [ "$rc" -eq 0 ]; then echo pass
  elif [ "$rc" -eq 1 ] && [ -n "$out" ]; then echo refuse
  else echo "error$rc"; fi
}
gate_variant() { # gate_variant <name> <sed program> — a broken copy of the gate; prints it
  local f="$tmp/gate-$1.sh"
  sed "$2" "$GATE" > "$f"
  cmp -s "$GATE" "$f" && { echo "gate_variant $1: sed changed nothing" >&2; return 1; }
  echo "$f"
}
G_ALWAYS_PASS="$(gate_variant always-pass '/^tmo=/a exit 0')"
G_ALWAYS_REFUSE="$(gate_variant always-refuse 's/^\[ "\${#survivors\[@\]}" -eq 0 \] && { passed=true; exit 0; }$/false/')"
G_NO_G2="$(gate_variant no-g2 's/^survivors=()$/survivors=(); mutants=()/')"
G_LITERAL_RUN="$(gate_variant literal-run '0,/^run_test "\$t"$/s//run_test .\/run/')"
G_NO_CLEANUP="$(gate_variant no-cleanup '/^  \[ -z "\$d" \] || rm -rf "\$d"$/d')"
# The gate before DONE was set aside while it ran, and one that never puts DONE back.
G_DONE_IN_PLACE="$(gate_variant done-in-place 's/^  mv -f "\$ws\/DONE" "\$ws\/DONE.pending".*/  :/; /^  moved=true$/d')"
G_NO_RESTORE="$(gate_variant no-restore 's/then mv -f "\$ws\/DONE.pending" "\$ws\/DONE";/then rm -f "$ws\/DONE.pending";/')"

T0_GOOD='out="$(printf "abc\ndef\n" | "$BENCH_TARGET")" || exit 1
[ "$out" = "$(printf "ABC\nDEF")" ]'
gw_a="$(gws a -)"
gw_b="$(gws b 'exit 1')"
gw_c="$(gws c 'exit 0')"
gw_d="$(gws d 'printf "abc\n" | "$BENCH_TARGET" > /dev/null')"
gw_e="$(gws e "$T0_GOOD")"
gw_f="$(gws f '[ "$BENCH_TARGET" = ./run ]')"
gate_case() { # gate_case <label> <ws> <want> <broken gate> — the gate, then its broken copy
  local got
  [ -f "$4" ] || { bad "gate $1: broken gate missing"; return; }
  got="$(verdict "$GATE" "$2")"
  check "gate $1: $3 (got $got)" test "$got" = "$3"
  got="$(verdict "$4" "$2")"
  check "gate $1, broken gate ($(basename "$4" .sh)): verdict changes (got $got)" test "$got" != "$3"
}
gate_case "(a) no ./test"                         "$gw_a" refuse "$G_ALWAYS_PASS"
gate_case "(b) ./test fails on the correct run"   "$gw_b" refuse "$G_ALWAYS_PASS"
gate_case "(c) an exit-0 ./test"                  "$gw_c" refuse "$G_NO_G2"
gate_case "(d) an exit-status-only ./test"        "$gw_d" refuse "$G_NO_G2"
gate_case "(e) a \$(…) comparison that checks exit status" "$gw_e" pass "$G_ALWAYS_REFUSE"
gate_case "(f) a ./test that sniffs BENCH_TARGET" "$gw_f" refuse "$G_LITERAL_RUN"
check "gate (a): the reason says ./test is required" bash -c '
  TMPDIR="$3" bash "$1" "$2" | grep -q "./test is missing"' _ "$GATE" "$gw_a" "$tmp/gtmp"
check "gate (d): the reason names a surviving broken copy" bash -c '
  TMPDIR="$3" bash "$1" "$2" | grep -q "passed against a copy of ./run that ignores its input"' \
  _ "$GATE" "$gw_d" "$tmp/gtmp"
if command -v python3 > /dev/null; then
  gw_g1="$(gws g1 'out="$(printf "%s\n" "{\"tier\": \"gold\", \"qty\": 12, \"unit_price\": 250, \"coupon\": \"PCT10\", \"day\": \"sat\"}" "{\"tier\": \"Gold\", \"qty\": 0, \"unit_price\": 100, \"coupon\": \"X\", \"day\": \"mon\"}" | "$BENCH_TARGET")" || exit 1
[ "$out" = "$(printf "%s\n" "{\"price\": 2250}" "{\"error\": \"invalid_tier\"}")" ]' T1)"
  # --data reaches every copy: the T2 store needs it to start at all.
  gw_g2="$(gws g2 'd="$(mktemp -d)"; trap "rm -rf \"\$d\"" EXIT
out="$(printf "SET a 1\nGET a\n" | "$BENCH_TARGET" --data "$d")" || exit 1
[ "$out" = "$(printf "OK\nVAL 1")" ]' T2)"
  gate_case "(g) a good T1 ./test" "$gw_g1" pass "$G_ALWAYS_REFUSE"
  gate_case "(g) a good T2 ./test" "$gw_g2" pass "$G_ALWAYS_REFUSE"
else
  echo "skip gate (g): no python3 for the T1/T2 reference ./run"
fi
check "gate (h): no copy of ./run is left behind" test -z "$(ls -A "$tmp/gtmp")"
mkdir -p "$tmp/gtmp-broken"
TMPDIR="$tmp/gtmp-broken" bash "$G_NO_CLEANUP" "$gw_e" > /dev/null 2>&1
check "gate (h), broken gate (no-cleanup): copies are left behind" test -n "$(ls -A "$tmp/gtmp-broken")"
check "gate: refuses a missing workspace with the usage exit 2" exits 2 bash "$GATE" "$tmp/gate/nope"

# DONE while the gate runs: set aside, back only on a pass. A run's watchdog that kills
# the gate mid-check must find no DONE, or a run the gate never cleared counts as done.
done_files() { # done_files <gate script> <ws> [kill-after-s] — which of DONE, DONE.pending remain
  if [ -n "${3:-}" ]; then
    # SIGKILL: no trap of the gate's runs. Its ./test child is orphaned; its own timeout reaps it.
    TMPDIR="$tmp/gtmp" timeout -s KILL "$3" bash "$1" "$2" > /dev/null 2>&1 < /dev/null
  else
    TMPDIR="$tmp/gtmp" bash "$1" "$2" > /dev/null 2>&1
  fi
  local f out=""
  for f in DONE DONE.pending; do [ -e "$2/$f" ] && out+="$f "; done
  echo "${out% }"
}
SLOW_TEST='sleep 30' # outlives the kill below; DONE_GATE_TIMEOUT (15) ends it afterwards
# The broken copies must still gate, or "DONE left" below could come from a crash.
check "gate (DONE), broken gate done-in-place still refuses an exit-0 ./test" \
  test "$(verdict "$G_DONE_IN_PLACE" "$(gws dv-old 'exit 0')")" = refuse
check "gate (DONE), broken gate no-restore still passes a good ./test" \
  test "$(verdict "$G_NO_RESTORE" "$(gws dv-nr "$T0_GOOD")")" = pass
check "gate (DONE): killed mid-check -> no DONE left, only DONE.pending" \
  test "$(done_files "$GATE" "$(gws dk-real "$SLOW_TEST")" 2)" = DONE.pending
check "gate (DONE), broken gate (done-in-place): killed mid-check -> DONE left" \
  test "$(done_files "$G_DONE_IN_PLACE" "$(gws dk-old "$SLOW_TEST")" 2)" = DONE
check "gate (DONE): a pass -> DONE present, no DONE.pending" \
  test "$(done_files "$GATE" "$(gws dp-real "$T0_GOOD")")" = DONE
check "gate (DONE), broken gate (no-restore): a pass -> no DONE" \
  test -z "$(done_files "$G_NO_RESTORE" "$(gws dp-broken "$T0_GOOD")")"
check "gate (DONE): a refusal -> neither DONE nor DONE.pending" \
  test -z "$(done_files "$GATE" "$(gws dr-real 'exit 0')")"
check "gate (DONE), broken gate (done-in-place): a refusal -> DONE left" \
  test "$(done_files "$G_DONE_IN_PLACE" "$(gws dr-old 'exit 0')")" = DONE

# Hook: P1.stop-hook.sh on canned Stop input. Its gate runs under bwrap; where user
# namespaces are unavailable (the flake check's sandbox), a stand-in that honours only the
# gate's bind and --chdir runs it unsandboxed.
if bwrap --ro-bind / / --dev /dev --proc /proc --unshare-net --unshare-pid true > /dev/null 2>&1; then
  hook_bwrap=bwrap
else
  echo "note hook: bwrap cannot run here; the hook's gate runs through an unsandboxed stand-in"
  hook_bwrap="$tmp/fake-bwrap"
  printf '#!%s\n' "$BASH_BIN" > "$hook_bwrap"
  cat >> "$hook_bwrap" <<'EOF'
gate="" dir=.
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --ro-bind|--bind) [ "$3" = /tmp/done-gate.sh ] && gate="$2"; shift 3 ;;
    --chdir) dir="$2"; shift 2 ;;
    --dev|--proc|--tmpfs) shift 2 ;;
    *) shift ;;
  esac
done
args=()
for a in "$@"; do
  [ "$a" = /tmp/done-gate.sh ] && a="$gate"
  [ "$a" = TMPDIR=/tmp ] && a="TMPDIR=${TMPDIR:-/tmp}"
  args+=("$a")
done
cd "$dir" && exec "${args[@]}"
EOF
  chmod 0755 "$hook_bwrap"
fi
# Broken hooks run from a bench-shaped copy, so they still find lib/done-gate.sh.
# [gate] swaps in another gate; then an unchanged hook is allowed (the gate is the change).
hook_variant() { # hook_variant <name> <sed program> [gate] — prints the hook copy's path
  local b="$tmp/hb-$1"
  mkdir -p "$b/parts" "$b/lib"
  cp "${3:-$GATE}" "$b/lib/done-gate.sh"
  sed "$2" "$BENCH/parts/P1.stop-hook.sh" > "$b/parts/P1.stop-hook.sh"
  if [ -z "${3:-}" ] && cmp -s "$BENCH/parts/P1.stop-hook.sh" "$b/parts/P1.stop-hook.sh"; then
    echo "hook_variant $1: sed changed nothing" >&2; return 1
  fi
  echo "$b/parts/P1.stop-hook.sh"
}
# A gate SIGKILLed right after it set DONE aside: the case only the hook can tidy.
G_KILLED="$(gate_variant killed '/^  moved=true$/a kill -KILL $$')"
hook() { # hook <script> <ws> — runs it on a Stop input; stdout in $tmp/hook.out, prints exit
  jq -cn --arg cwd "$2" '{session_id: "selftest", hook_event_name: "Stop", stop_hook_active: false, cwd: $cwd}' \
    | BENCH_GATE_BWRAP="$hook_bwrap" bash "$1" "$2" > "$tmp/hook.out" 2> "$tmp/hook.err"
  echo "$?"
}
hk_i() { # (i) no DONE: silent exit 0, gate not run, no ledger
  [ -f "$2" ] || return 3
  local w="$tmp/hk-i-$1"; rm -rf "$w" "$w.gate.jsonl"; mkdir -p "$w"
  install -m 0755 "$BENCH/tasks/T0/solution/run" "$w/run"
  [ "$(hook "$2" "$w")" = 0 ] && [ ! -s "$tmp/hook.out" ] && [ ! -e "$w.gate.jsonl" ]
}
hk_j() { # (j) a bad ./test: block with a reason, DONE gone, one refused ledger line
  [ -f "$2" ] || return 3
  local w; w="$(gws "hk-j-$1" 'exit 0')"; rm -f "$w.gate.jsonl"
  [ "$(hook "$2" "$w")" = 0 ] \
    && jq -e '.decision == "block" and (.reason | test("passed against a copy of ./run") and test("DONE was removed"))' \
      "$tmp/hook.out" > /dev/null \
    && [ ! -e "$w/DONE" ] && [ "$(wc -l < "$w.gate.jsonl")" -eq 1 ] \
    && jq -e '.verdict == "refused"' "$w.gate.jsonl" > /dev/null
}
hk_k() { # (k) the 6th refusal: the stop is allowed, DONE gone, ledger ends exhausted
  [ -f "$2" ] || return 3
  local w; w="$(gws "hk-k-$1" 'exit 0')"
  for _ in 1 2 3 4 5; do printf '%s\n' '{"verdict":"refused"}'; done > "$w.gate.jsonl"
  [ "$(hook "$2" "$w")" = 0 ] && ! grep -q block "$tmp/hook.out" && [ ! -e "$w/DONE" ] \
    && [ "$(tail -n 1 "$w.gate.jsonl" | jq -r .verdict)" = exhausted ]
}
hk_l() { # (l) a good ./test: the stop is allowed, DONE kept
  [ -f "$2" ] || return 3
  local w; w="$(gws "hk-l-$1" "$T0_GOOD")"; rm -f "$w.gate.jsonl"
  [ "$(hook "$2" "$w")" = 0 ] && [ ! -s "$tmp/hook.out" ] && [ -e "$w/DONE" ] \
    && [ "$(jq -r .verdict "$w.gate.jsonl")" = pass ]
}
hk_m() { # (m) the gate killed mid-check: block, neither DONE nor DONE.pending left
  [ -f "$2" ] || return 3
  local w; w="$(gws "hk-m-$1" "$T0_GOOD")"; rm -f "$w.gate.jsonl"
  [ "$(hook "$2" "$w")" = 0 ] && jq -e '.decision == "block"' "$tmp/hook.out" > /dev/null \
    && [ ! -e "$w/DONE" ] && [ ! -e "$w/DONE.pending" ] \
    && [ "$(jq -r .verdict "$w.gate.jsonl")" = refused ]
}
