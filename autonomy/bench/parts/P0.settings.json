{
  "env": {
    "BENCH_TARGET": "./run"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": ["@WS@"],
      "denyRead": [
        "@ROOT@/autonomy/**/grader/**",
        "@ROOT@/**/autonomy/**/grader/**",
        "@ROOT@/autonomy/**/solution/**",
        "@ROOT@/**/autonomy/**/solution/**"
      ]
    },
    "network": {
      "strictAllowlist": true
    }
  }
}
