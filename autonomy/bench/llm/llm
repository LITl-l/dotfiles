#!/usr/bin/env bash
# llm — Phase 0b tooling for the pi model candidates in autonomy/bench/models.json.
#
#   llm fetch <id>                       download the GGUF into llama.cpp's cache
#   llm serve <id> [--port N] [ARG…]     llama-server in the foreground (default port 8081)
#   llm bench <id>                       llama-bench at -t 16 and -t 8; JSON lines on stdout
#   llm pi-run <ws> <id> <timeout_s>     pi non-interactive inside bwrap; one JSON line:
#       {"exit":n,"timeout":bool,"wall_s":x,"tool_cpu_s":y,"malformed_tool_calls":n,"loops":n}
#
# Environment:
#   BENCH_LLM_PORT          endpoint port on the host (default 8081)
#   BENCH_LLM_THREADS       llama-server -t for serve (default 8)
#   BENCH_LLM_SERVE_CMD     script run as `bash <script> <id> --port N` instead of `llm serve`
#   BENCH_LLM_LOAD_TIMEOUT  seconds pi-run waits for a server it started (default 900)
#   BENCH_PI_PROMPT         prompt file for pi-run (default autonomy/bench/prompt.md)
#   LLM_DRY_RUN=1           fetch / serve / bench print each argv as a JSON array instead
#
# Exit codes: 0 ok, 1 runtime failure, 2 usage error. pi-run exits 0 whenever it could
# report the run, including when pi failed or timed out; that outcome is in the JSON.
set -uo pipefail

LLM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BENCH="$(dirname "$LLM_DIR")"
MODELS="$BENCH/models.json"
PORT="${BENCH_LLM_PORT:-8081}"
INNER_PORT=8081 # what pi sees inside the sandbox, whatever the host port is

die()  { printf 'llm: %s\n' "$*" >&2; exit 2; }
fail() { printf 'llm: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,9s/^# \{0,1\}//p' "${BASH_SOURCE[0]}" >&2; exit 2; }

model_entry() {
  jq -ce --arg id "$1" '.models[] | select(.id == $id)' "$MODELS" 2> /dev/null ||
    die "unknown model '$1' (ids: $(jq -r '[.models[].id] | join(", ")' "$MODELS"))"
}

run_argv() {
  if [ -n "${LLM_DRY_RUN:-}" ]; then jq -cn '$ARGS.positional' --args -- "$@"; else "$@"; fi
}

hf_ref() { jq -r '"\(.hf_repo):\(.quant)"' <<< "$1"; }

# --- fetch / serve / bench ------------------------------------------------------------

cmd_fetch() {
  [ $# -eq 1 ] || usage
  local m
  m="$(model_entry "$1")" || exit 2
  # llama-bench -hf downloads into llama.cpp's own cache layout, then one 1-token test
  # confirms the file loads. llama-server has no exit-after-load flag to do the same.
  local argv=(llama-bench -hf "$(hf_ref "$m")" -p 0 -n 1 -r 1 -o jsonl)
  if [ -n "${LLM_DRY_RUN:-}" ]; then run_argv "${argv[@]}"; return; fi
  "${argv[@]}" > /dev/null || fail "fetch failed for $1"
}

serve_argv() { # serve_argv ENTRY PORT — one argv element per line
  # -t is explicit because llama-server's default thread count is not pinned down, and
  # it matters: Qwen3.6-35B-A3B tg128 is 8.63 t/s at -t 8 but 0.65 t/s at -t 16 on this
  # host, unchanged by OPENBLAS_NUM_THREADS=1 (autonomy/results/O2-llama-bench*.md).
  jq -r --arg port "$2" --arg threads "${BENCH_LLM_THREADS:-8}" '
    ["llama-server", "-hf", "\(.hf_repo):\(.quant)", "--offline",
     "--host", "127.0.0.1", "--port", $port, "--alias", .id, "-t", $threads]
    + .server_flags
    + ([.sampling | to_entries[] | ["--" + (.key | gsub("_"; "-")), (.value | tostring)]] | add // [])
    + (if .thinking == false then ["--reasoning", "off"] else [] end)
    | .[]' <<< "$1"
}

cmd_serve() {
  [ $# -ge 1 ] || usage
  local id="$1" port="$PORT" m extra=() argv=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --port) [ $# -ge 2 ] || die "--port needs a value"; port="$2"; shift 2 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  m="$(model_entry "$id")" || exit 2
  mapfile -t argv < <(serve_argv "$m" "$port")
  if [ -n "${LLM_DRY_RUN:-}" ]; then run_argv "${argv[@]}" "${extra[@]}"; exit 0; fi
  exec "${argv[@]}" "${extra[@]}"
}

cmd_bench() {
  [ $# -eq 1 ] || usage
  local m t argv
  m="$(model_entry "$1")" || exit 2
  for t in 16 8; do
    argv=(llama-bench -hf "$(hf_ref "$m")" -t "$t" -p "512,4096" -n 128 -fa on -o jsonl)
    if [ -n "${LLM_DRY_RUN:-}" ]; then run_argv "${argv[@]}"; continue; fi
    "${argv[@]}" | jq -c --arg id "$1" '{kind: "llm-bench", model: $id} + .'
    [ "${PIPESTATUS[0]}" -eq 0 ] || fail "llama-bench -t $t failed for $1"
  done
}

# --- pi-run ---------------------------------------------------------------------------

http_get() { # http_get URL — body on stdout; fails unless HTTP 200. Bypasses any proxy.
  python3 -c '
import sys, urllib.request
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
try:
    r = opener.open(sys.argv[1], timeout=3)
    sys.stdout.write(r.read().decode())
    sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)' "$1"
}

times_children() { # times_children FILE — children user+sys seconds from `times` output
  awk 'NR == 2 { s = 0; for (i = 1; i <= 2; i++) { split($i, a, "m"); sub("s", "", a[2]); s += a[1] * 60 + a[2] }
                 printf "%.3f\n", s }' "$1"
}

# malformed_tool_calls: tool calls pi rejected before running them (unparseable or
# schema-invalid arguments, unknown tool). A tool that ran and failed is not malformed.
# loops: runs of >= 3 consecutive identical tool calls (same name and arguments).
# Both are null when the event stream holds no agent_start, i.e. pi produced no events.
# shellcheck disable=SC2016 # a jq program: $ev and $c are jq variables
COUNT_JQ='
  [inputs | fromjson? | objects] as $ev
  | if ($ev | any(.type == "agent_start")) | not then {malformed_tool_calls: null, loops: null}
    else {
      malformed_tool_calls: [$ev[] | select(.type == "tool_execution_end" and .isError == true)
        | [(.result.content // [])[] | .text? // ""] | join("")
        | select(test("^(Invalid arguments for tool|Validation failed for tool|Tool \\S+ not found)"))]
        | length,
      loops: ([$ev[] | select(.type == "tool_execution_start") | [.toolName, .args] | tojson]
        | reduce .[] as $c ({prev: null, run: 0, loops: 0};
            (if $c == .prev then .run += 1 else .prev = $c | .run = 1 end)
            | if .run == 3 then .loops += 1 else . end)
        | .loops)
    } end'

cmd_pi_run() {
  [ $# -eq 3 ] || usage
  local ws="$1" id="$2" tmo="$3" m
  [ -d "$ws" ] || die "workspace '$ws' is not a directory"
  [[ "$tmo" =~ ^[1-9][0-9]*$ ]] || die "timeout_s must be a positive integer (got '$tmo')"
  m="$(model_entry "$id")" || exit 2
  ws="$(cd "$ws" && pwd)"
  local prompt_file="${BENCH_PI_PROMPT:-$BENCH/prompt.md}"
  [ -r "$prompt_file" ] || die "cannot read prompt $prompt_file"
  local bwrap_bin bash_bin
  bwrap_bin="$(command -v bwrap)" || fail "bwrap not found (run inside nix develop .#bench)"
  bash_bin="$(command -v bash)"
  command -v pi > /dev/null || fail "pi not found (run inside nix develop .#bench)"

  local logdir="${ws%/}.pi" base="http://127.0.0.1:$PORT"
  mkdir -p "$logdir" || fail "cannot create $logdir"
  rt="$(mktemp -d)" || fail "mktemp failed"
  serve_pid="" bridge_pid=""
  trap 'pi_run_cleanup' EXIT

  # 1. Use the endpoint if it answers; otherwise start serve and wait for it to load.
  if ! http_get "$base/health" > /dev/null; then
    local serve_cmd=(bash "$LLM_DIR/llm" serve)
    [ -n "${BENCH_LLM_SERVE_CMD:-}" ] && serve_cmd=(bash "$BENCH_LLM_SERVE_CMD")
    "${serve_cmd[@]}" "$id" --port "$PORT" > "$logdir/serve.log" 2>&1 &
    serve_pid=$!
    local deadline=$((SECONDS + ${BENCH_LLM_LOAD_TIMEOUT:-900}))
    until http_get "$base/health" > /dev/null; do
      kill -0 "$serve_pid" 2> /dev/null || fail "serve exited before it answered (see $logdir/serve.log)"
      ((SECONDS < deadline)) || fail "serve did not answer within the load timeout"
      sleep 0.5
    done
  fi
  http_get "$base/v1/models" | jq -e --arg id "$id" '.data | any(.id == $id)' > /dev/null ||
    fail "the endpoint on port $PORT does not serve '$id'"

  # 2. Sandbox inputs. The user's ~/.pi/agent is mounted read-only at /run/pi-agent-src.
  # The visible ~/.pi/agent is a throwaway dir of symlinks into it, not that mount
  # itself: pi 1.5.2 exits with EROFS when it cannot create trust.json.lock there.
  # Writes through a symlink hit the read-only mount, and new files vanish with $rt.
  # models.json is replaced by one bench provider, and auth.json is left out: no
  # credentials enter the sandbox.
  local agent_src="$HOME/.pi/agent" e b
  mkdir -p "$rt/agent" "$rt/tools" "$rt/sock" "$rt/out"
  if [ -d "$agent_src" ]; then
    for e in "$agent_src"/* "$agent_src"/.[!.]*; do
      [ -e "$e" ] || [ -L "$e" ] || continue
      b="$(basename "$e")"
      case "$b" in
        models.json | auth.json | sessions) ;;
        settings.json) install -m 0644 "$e" "$rt/agent/settings.json" ;;
        *) ln -s "/run/pi-agent-src/$b" "$rt/agent/$b" ;;
      esac
    done
  fi
  jq -n --arg id "$id" --arg url "http://127.0.0.1:$INNER_PORT/v1" --argjson m "$m" '
    ($m.server_flags | [range(length) as $i | select(.[$i] == "-c") | $i][0]) as $c
    | {providers: {bench: {api: "openai-completions", apiKey: "local", baseUrl: $url,
        models: [{id: $id} + (if $c then {contextWindow: ($m.server_flags[$c + 1] | tonumber)} else {} end)]}}}' \
    > "$rt/agent/models.json"
  install -m 0755 "$LLM_DIR/bridge.py" "$LLM_DIR/sandbox-init" "$rt/tools/"

  python3 "$LLM_DIR/bridge.py" unix2tcp "$rt/sock/llm.sock" 127.0.0.1 "$PORT" &
  bridge_pid=$!
  local i
  for ((i = 0; i < 100; i++)); do [ -S "$rt/sock/llm.sock" ] && break; sleep 0.05; done
  [ -S "$rt/sock/llm.sock" ] || fail "endpoint bridge did not start"

  # 3. The sandbox: own namespaces (no host network, no host pids), the workspace
  # read-write, /nix/store read-only, and nothing else of the host's home: the dotfiles
  # checkout, other worktrees and the bench's graders stay out of reach.
  local inner_path
  inner_path="$(dirname "$bash_bin"):$(tr ':' '\n' <<< "$PATH" | grep '^/nix/store/' | paste -sd:)"
  # --no-extensions: the user's extensions import pi by the home-manager store path, not
  # the devShell's, and in -p mode one failed extension load exits 1. Phase 1 parts are
  # loaded explicitly with -e, which still works under --no-extensions.
  local pi_args=(-p --mode json --no-session --offline --no-extensions
    --provider bench --model "$id")
  [ "$(jq -r '.thinking' <<< "$m")" = false ] && pi_args+=(--thinking off)
  pi_args+=(-- "$(cat "$prompt_file")")
  local bw=(
    "$bwrap_bin" --unshare-all --die-with-parent --new-session
    --ro-bind /nix/store /nix/store
    --proc /proc --dev /dev --tmpfs /tmp
    --ro-bind-try /bin /bin --ro-bind-try /usr/bin /usr/bin
    --ro-bind-try /etc/passwd /etc/passwd --ro-bind-try /etc/group /etc/group
    --ro-bind-try /etc/hosts /etc/hosts --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf
    --ro-bind-try /etc/localtime /etc/localtime
    --tmpfs "$HOME"
    --bind "$rt/agent" "$HOME/.pi/agent"
    --ro-bind "$rt/tools" /run/llm-tools
    --bind "$rt/sock" /run/llm-sock
    --bind "$rt/out" /run/llm-out
  )
  [ -d "$agent_src" ] && bw+=(--ro-bind "$agent_src" /run/pi-agent-src)
  bw+=(--bind "$ws" "$ws" --chdir "$ws"
    -- "$bash_bin" /run/llm-tools/sandbox-init "$INNER_PORT" /run/llm-sock/llm.sock "$tmo"
    /run/llm-out "${pi_args[@]}")

  # 4. Run. sandbox-init enforces the timeout and measures CPU (see there for why it
  # cannot be measured from out here). This outer timeout is only a backstop for a
  # sandbox that hangs outside pi; when it fires, there is no CPU figure.
  local t0 t1 rc
  t0="$EPOCHREALTIME"
  timeout -k 10 $((tmo + 30)) env -i PATH="$inner_path" HOME="$HOME" USER="$(id -un)" \
    LOGNAME="$(id -un)" TERM=dumb LANG=C.UTF-8 TMPDIR=/tmp PI_OFFLINE=1 \
    "${bw[@]}" > "$logdir/events.jsonl" 2> "$logdir/stderr.txt"
  rc=$?
  t1="$EPOCHREALTIME"

  local timed_out=false wall cpu=null counts
  { [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; } && timed_out=true
  wall="$(awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%.3f\n", b - a }')"
  if [ -s "$rt/out/times0" ] && [ -s "$rt/out/times1" ]; then
    cpu="$(awk -v a="$(times_children "$rt/out/times0")" -v b="$(times_children "$rt/out/times1")" \
      'BEGIN { printf "%.3f\n", b - a }')"
  fi
  counts="$(jq -Rnc "$COUNT_JQ" "$logdir/events.jsonl")" ||
    counts='{"malformed_tool_calls":null,"loops":null}'
  jq -cn --argjson exit "$rc" --argjson timeout "$timed_out" --argjson wall "$wall" \
    --argjson cpu "$cpu" --argjson counts "$counts" \
    '{exit: $exit, timeout: $timeout, wall_s: $wall, tool_cpu_s: $cpu} + $counts'
}

pi_run_cleanup() {
  [ -n "${bridge_pid:-}" ] && kill "$bridge_pid" 2> /dev/null
  if [ -n "${serve_pid:-}" ]; then
    kill "$serve_pid" 2> /dev/null
    wait "$serve_pid" 2> /dev/null
  fi
  [ -n "${rt:-}" ] && rm -rf "$rt"
}

[ $# -ge 1 ] || usage
sub="$1"
shift
case "$sub" in
  fetch) cmd_fetch "$@" ;;
  serve) cmd_serve "$@" ;;
  bench) cmd_bench "$@" ;;
  pi-run) cmd_pi_run "$@" ;;
  -h | --help) usage ;;
  *) die "unknown subcommand '$sub' (fetch, serve, bench, pi-run)" ;;
esac
