      "Bash(claude stop:*)",
      "Bash(command -v *)",
      "Bash(cut:*)",
      "Bash(diff *)",
      "Bash(diff:*)",
      "Bash(direnv:*)",
      "Bash(dirname *)",
      "Bash(dirname:*)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(file:*)",
      "Bash(find *)",
      "Bash(find:*)",
      "Bash(fish:*)",
      "Bash(fleet:*)",
      "Bash(gh api user*)",
      "Bash(gh api:*)",
      "Bash(gh auth status*)",
      "Bash(gh auth switch *)",
      "Bash(gh auth:*)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view *)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list*)",
      "Bash(gh run list:*)",
      "Bash(gh run view*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git worktree:*)",
      "Bash(grep *)",
      "Bash(grep:*)",
      "Bash(head *)",
      "Bash(head:*)",
      "Bash(home-manager switch:*)",
      "Bash(jj bookmark list*)",
      "Bash(jj bookmark move *)",
      "Bash(jj bookmark set *)",
      "Bash(jj describe *)",
      "Bash(jj diff *)",
      "Bash(jj edit *)",
      "Bash(jj evolog*)",
      "Bash(jj file list*)",
      "Bash(jj file show*)",
      "Bash(jj git fetch*)",
      "Bash(jj interdiff *)",
      "Bash(jj log *)",
      "Bash(jj new *)",
      "Bash(jj op log*)",
      "Bash(jj op restore *)",
      "Bash(jj op show*)",
      "Bash(jj rebase *)",
      "Bash(jj resolve *)",
      "Bash(jj resolve --list*)",
      "Bash(jj show *)",
      "Bash(jj squash *)",
      "Bash(jj st*)",
      "Bash(jj undo*)",
      "Bash(jj workspace list*)",
      "Bash(jj workspace root*)",
      "Bash(jj workspace update-stale*)",
      "Bash(jj:*)",
      "Bash(jq *)",
      "Bash(jq:*)",
      "Bash(just:*)",
      "Bash(ls *)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(nix build:*)",
      "Bash(nix derivation:*)",
      "Bash(nix develop --command npm *)",
      "Bash(nix develop --command npx *)",
      "Bash(nix develop --command python3 tools/*)",
      "Bash(nix develop --command uv run alembic current*)",
      "Bash(nix develop --command uv run alembic heads*)",
      "Bash(nix develop --command uv run alembic history*)",
      "Bash(nix develop --command uv run mypy *)",
      "Bash(nix develop --command uv run pytest *)",
      "Bash(nix develop --command uv run python tools/*)",
      "Bash(nix develop --command uv run ruff check*)",
      "Bash(nix develop -c npm *)",
      "Bash(nix develop -c npx *)",
      "Bash(nix develop -c python3 tools/*)",
      "Bash(nix develop -c uv run alembic heads*)",
      "Bash(nix develop -c uv run pytest *)",
      "Bash(nix develop -c uv run ruff check*)",
      "Bash(nix develop:*)",
      "Bash(nix eval:*)",
      "Bash(nix flake check:*)",
      "Bash(nix path-info:*)",
      "Bash(nix search:*)",
      "Bash(nix-instantiate:*)",
      "Bash(node *)",
      "Bash(node:*)",
      "Bash(node_modules/.bin/vitest *)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run type-check*)",
      "Bash(npm test*)",
      "Bash(npm:*)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx:*)",
      "Bash(nvim --headless:*)",
      "Bash(printf *)",
      "Bash(pwd*)",
      "Bash(pwd:*)",
      "Bash(python3 tools/*)",
      "Bash(realpath:*)",
      "Bash(rg *)",
      "Bash(rg:*)",
      "Bash(sed -n *)",
      "Bash(sed:*)",
      "Bash(sort *)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail *)",
      "Bash(tail:*)",
      "Bash(test *)",
      "Bash(tree:*)",
      "Bash(tsc:*)",
      "Bash(uniq *)",
      "Bash(uniq:*)",
      "Bash(uv run alembic current*)",
      "Bash(uv run alembic heads*)",
      "Bash(uv run alembic history*)",
      "Bash(uv run mypy *)",
      "Bash(uv run pytest *)",
      "Bash(uv run python tools/*)",
      "Bash(uv run ruff check*)",
      "Bash(wc *)",
      "Bash(wc:*)",
      "Bash(which *)",
      "Bash(which:*)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__context7"
    ],
    "deny": [
      "Bash(rm -rf ~)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm:*)",
      "Bash(chmod -R 777:*)",
      "Bash(nix-collect-garbage:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(jj git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(nix flake update:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/nixos/wkspace",
      "/home/nixos/.config/dotfiles"
    ]
  },
  "model": "claude-opus-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/gh-api-write-guard.sh",
            "if": "Bash(gh api:*)"
          },
          {
            "type": "command",
            "command": "~/.claude/blocking-wait-nudge.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/full-suite-nudge.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/ast-grep-nudge-hook.sh",
            "if": "Bash(grep:*)"
          },
          {
            "type": "command",
            "command": "~/.claude/ast-grep-nudge-hook.sh",
            "if": "Bash(rg:*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/full-suite-nudge.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/stop-phrase-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/stop-hook-git-check.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/wsl-clipboard-image-hook.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jj-master@local": true,
    "architect@local": true,
    "trs@local": true,
    "i-have-adhd@local": true,
    "i-have-asd@local": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "sourcegraph@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "advisorModel": "fable",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true
}
