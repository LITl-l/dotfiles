#!/usr/bin/env bash
# fleet — inspect and reap the Claude Code background-agent fleet.
#
# WHY THIS EXISTS (all five points were measured, not assumed; 1-4 on 2.1.267):
#   1. `claude logs <id>` returns raw ANSI/TUI screen frames — ~15k tokens of escape
#      codes for a one-line answer. It is unusable from an agent. `fleet out` reads the
#      session transcript JSONL instead. NEVER call `claude logs` from the meta agent.
#   2. `claude rm <id>` REFUSES to remove a session whose daemon socket is gone
#      ("couldn't remove ... the background service may be restarting"). The state then
#      leaks forever: a session sat in `state: blocked` for six weeks before anyone
#      noticed. `fleet gc` removes the orphaned job dir that `claude rm` cannot.
#   3. `claude agents --json` is the only cheap inventory, and `--cwd` scopes it to one
#      project — that is what makes "one project = one session" enforceable.
#   4. `fleet watch` emits one line per state TRANSITION so a Monitor can wake the meta
#      agent on events instead of polling each worker (polling N agents does not scale).
#   5. Nothing surfaced WHY a session was parked: the inventory gives a state, not a
#      reason, and the reason sits in the job state file next to the worker's entire spec
#      (`intent`), so `cat`ting it costs thousands of tokens. One session sat `blocked`
#      for six weeks. `fleet why` prints only the fields that explain the park.
set -uo pipefail

# Field separator for internal records. MUST NOT be whitespace: bash `read` collapses
# runs of IFS whitespace, which would silently shift columns whenever a field is empty.
SEP=$'\x1f'

JOBS_DIR="${HOME}/.claude/jobs"
PROJECTS_DIR="${HOME}/.claude/projects"

die() { printf 'fleet: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }
need jq

# Normalised inventory: id \t kind \t state \t waitingFor \t cwd \t name
snapshot() {
  local cwd_filter=("$@")
  claude agents --json "${cwd_filter[@]}" 2>/dev/null | jq -r '
    .[] | [ (.id // .sessionId[0:8]),
            .kind,
            (.state // .status // "?"),
            (.waitingFor // ""),
            (.cwd // ""),
            ((.name // "") | gsub("[\t\n]"; " ")) ] | map(tostring) | join("\u001f")'
}

cmd_ls() {
  local args=() self="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
  [ -n "${1:-}" ] && args=(--cwd "$1")
  local rows; rows="$(snapshot "${args[@]}")"
  [ -z "$rows" ] && { echo "(no sessions)"; return 0; }
  printf '%-10s %-12s %-10s %-28s %s\n' ID KIND STATE CWD NAME
  while IFS="$SEP" read -r id kind state wf cwd name; do
    [ -z "$id" ] && continue
    [ -n "$self" ] && [ "${self:0:8}" = "$id" ] && name="$name  <- this session"
    [ -n "$wf" ] && state="$state($wf)"
    printf '%-10s %-12s %-10s %-28s %s\n' \
      "$id" "$kind" "$state" "$(basename "$cwd")" "${name:0:60}"
  done <<<"$rows"
}

# Resolve a short id to its transcript file without knowing the cwd->slug mangling.
transcript_for() {
  local id="$1" f
  f="$(find "$PROJECTS_DIR" -name "${id}*.jsonl" -print -quit 2>/dev/null)"
  [ -n "$f" ] && { printf '%s\n' "$f"; return 0; }
  local full
  full="$(claude agents --json --all 2>/dev/null | jq -r --arg i "$id" \
    '.[] | select((.id // .sessionId[0:8]) == $i) | .sessionId' | head -1)"
  [ -n "$full" ] && find "$PROJECTS_DIR" -name "${full}.jsonl" -print -quit 2>/dev/null
}

cmd_out() {
  local id="${1:-}" n="${2:-40}"
  [ -z "$id" ] && die "usage: fleet out <id> [lines]"
  local f; f="$(transcript_for "$id")"
  if [ -z "$f" ]; then
    # Job state outlives the transcript: expiry deletes the JSONL and leaves
    # ~/.claude/jobs/<id>/ behind, so "never started" would be exactly wrong here. Say
    # which of the two cases this is, because they have different remedies.
    local d; d="$(job_dir_for "$id")"
    [ -n "$d" ] && [ -f "$d/state.json" ] \
      || die "no transcript or job state for '$id' (the session may never have started)"
    local ran; ran="$(jq -r '(.lastTerminalAt // .updatedAt // "unknown")[0:10]' "$d/state.json" 2>/dev/null)"
    printf 'fleet: transcript for %s is gone, but its job state is not — it ran until %s.\n' "$id" "$ran" >&2
    printf '  Transcripts expire: cleanupPeriodDays is now 36500, an older expiry took this one.\n' >&2
    die "read what is left from job state instead: fleet why $id"
  fi
  jq -r '
    select(.type=="assistant")
    | .message.content[]?
    | select(.type=="text")
    | .text' "$f" 2>/dev/null | tail -n "$n"
}

# Resolve a short id (or a full session id) to its job state dir.
job_dir_for() {
  local id="$1" d
  [ -d "$JOBS_DIR/$id" ] && { printf '%s\n' "$JOBS_DIR/$id"; return 0; }
  d="$(find "$JOBS_DIR" -mindepth 1 -maxdepth 1 -type d -name "${id:0:8}*" -print -quit 2>/dev/null)"
  [ -n "$d" ] && printf '%s\n' "$d"
}

cmd_why() {
  local id="${1:-}"
  [ -z "$id" ] && die "usage: fleet why <id>"
  local d; d="$(job_dir_for "$id")"
  [ -n "$d" ] || die "no job state for '$id' (try: fleet ls)"
  [ -f "$d/state.json" ] || die "no state.json under $d"
  # Print FIELDS, never the file: `intent` holds the worker's whole spec and `output` its
  # whole reply, so `cat state.json` is thousands of tokens for a one-line answer.
  jq -r '
    def f($v): $v // "(none)" | tostring;
    "id            \(f(.daemonShort))",
    "name          \(f(.name))",
    "state         \(f(.state))",
    "detail        \(f(.detail))",
    "needs         \(f(.needs))",
    "resumeSession \(f(.resumeSessionId))",
    "respawnFlags  \((.respawnFlags // []) | map(tostring) | join(" "))",
    "cwd           \(f(.cwd))",
    "updated       \(f(.updatedAt))"' "$d/state.json"
}

# A job is a zombie when nothing in the live inventory claims it.
zombie_ids() {
  # --all includes completed background sessions. Without it, a finished-but-kept
  # session looks orphaned and gc would destroy a conversation `claude attach` can reopen.
  local live; live="$(snapshot --all | cut -d"$SEP" -f1)"
  [ -d "$JOBS_DIR" ] || return 0
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    local id; id="$(basename "$d")"
    [ "$id" = "pins.json" ] && continue
    grep -qx -- "$id" <<<"$live" || printf '%s\n' "$id"
  done
}

# A `stopped` session is NOT a zombie: `claude agents --json --all` still lists it, so
# nothing above sees it as orphaned. Measured: nine job dirs dated Oct 16 - Nov 2 survived
# a `fleet gc` that reported `no orphaned job state`. Only an exact `state == "stopped"`
# qualifies, so a `done` session is still never collected here.
# $1: the zombie list, so these are not reported twice and the inventory is fetched once.
stopped_ids() {
  local zombies="${1:-}"
  [ -d "$JOBS_DIR" ] || return 0
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    [ -f "$d/state.json" ] || continue
    local id; id="$(basename "$d")"
    [ "$(jq -r '.state // ""' "$d/state.json" 2>/dev/null)" = "stopped" ] || continue
    grep -qx -- "$id" <<<"$zombies" && continue
    printf '%s\n' "$id"
  done
}

# $1: dry-run flag. $2: newline-separated ids.
reap_ids() {
  local dry="$1" ids="$2" id
  [ -z "$ids" ] && return 0
  while read -r id; do
    [ -z "$id" ] && continue
    # Try the supported path first; it fails when the daemon socket is gone.
    if [ "$dry" -eq 0 ]; then
      claude rm "$id" >/dev/null 2>&1
      if [ -d "$JOBS_DIR/$id" ]; then
        rm -rf "${JOBS_DIR:?}/$id" && echo "reaped  $id (claude rm could not; removed job state)"
      else
        echo "removed $id (via claude rm)"
      fi
    else
      echo "would reap $id"
    fi
  done <<<"$ids"
}

cmd_gc() {
  local dry=0 stopped=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift ;;
      --stopped) stopped=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  local ids leaked
  ids="$(zombie_ids)"
  leaked="$(stopped_ids "$ids")"
  [ -z "$ids" ] && [ -z "$leaked" ] && { echo "fleet: no orphaned job state"; return 0; }

  reap_ids "$dry" "$ids"

  [ -z "$leaked" ] && return 0
  # Reported, not removed, unless asked: each still carries a `resumeSessionId`, so
  # removing it destroys a conversation `claude --resume` can still reopen.
  if [ "$stopped" -eq 1 ]; then
    reap_ids "$dry" "$leaked"
  else
    while read -r id; do
      [ -z "$id" ] && continue
      echo "stopped $id (leaked job state; 'fleet why $id', then 'fleet gc --stopped')"
    done <<<"$leaked"
  fi
}

# One line per transition. Consumed by Monitor; keep stdout sparse.
cmd_watch() {
  local interval="${1:-20}" self="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
  local prev cur
  key() { snapshot | awk -F"$SEP" -v OFS="$SEP" -v s="${self:0:8}" '$1!=s {print $1,$2,$3,$4,$6}' | sort; }
  prev="$(key)"
  echo "fleet-watch armed ($(grep -c . <<<"$prev") member(s), ${interval}s)"
  while true; do
    sleep "$interval"
    cur="$(key)"
    comm -13 <(printf '%s\n' "$prev") <(printf '%s\n' "$cur") \
      | while IFS="$SEP" read -r id kind st wf nm; do
          [ -z "$id" ] && continue
          echo "-> $id [$kind] ${st}${wf:+ ($wf)} :: ${nm:0:50}"
        done
    comm -23 <(printf '%s\n' "$prev") <(printf '%s\n' "$cur") \
      | while IFS="$SEP" read -r id kind st wf nm; do
          [ -z "$id" ] && continue
          cut -d"$SEP" -f1 <<<"$cur" | grep -qx -- "$id" || echo "x  $id [$kind] gone (was $st) :: ${nm:0:50}"
        done
    prev="$cur"
  done
}

# Refuse to dispatch work that has no termination condition or output path.
# MAST (arXiv:2503.13657, 1600+ traces): 79% of multi-agent failures are specification
# and coordination defects; "unaware of termination conditions" is a top-3 mode.
cmd_spawn() {
  local name="" dir="" spec="" model="" mode="acceptEdits" effort="medium"
  while [ $# -gt 0 ]; do
    case "$1" in
      --name)  name="$2"; shift 2 ;;
      --dir)   dir="$2";  shift 2 ;;
      --spec)  spec="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --permission-mode) mode="$2"; shift 2 ;;
      --effort) effort="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -n "$name" ] && [ -n "$dir" ] && [ -n "$spec" ] \
    || die "usage: fleet spawn --name N --dir PATH --spec FILE [--model M] [--permission-mode M] [--effort E]"
  [ -f "$spec" ] || die "spec file not found: $spec"
  [ -d "$dir" ]  || die "workspace dir not found: $dir"

  local missing=()
  grep -qi '^## *Termination'  "$spec" || missing+=("## Termination condition")
  grep -qi '^## *Output'       "$spec" || missing+=("## Output")
  grep -qi '^## *Boundary'     "$spec" || missing+=("## Boundary")
  if [ ${#missing[@]} -gt 0 ]; then
    printf 'fleet: spec is missing required section(s):\n' >&2
    printf '  - %s\n' "${missing[@]}" >&2
    die "refusing to dispatch an underspecified worker (see claude/worker-spec.template.md)"
  fi

  # A worker runs a pre-specified task with nobody reading its prose, so it gets medium
  # effort and no Explanatory style. Both cost time on every turn: the 2026-11 measurement
  # had the worker's real work at 3-6 min in a 93 min meta run.
  local flags=(--bg -n "$name" --permission-mode "$mode" --effort "$effort"
    --settings '{"enabledPlugins":{"explanatory-output-style@claude-plugins-official":false}}')
  [ -n "$model" ] && flags+=(--model "$model")
  # Read the spec BEFORE cd: a relative --spec path would not resolve inside the subshell,
  # and an unreadable spec would silently dispatch a worker with an empty prompt.
  local prompt; prompt="$(cat "$spec")"
  [ -n "$prompt" ] || die "spec file is empty: $spec"

  # An unattended worker cannot answer a permission prompt: in a prompting mode it parks
  # in `waiting` indefinitely. Say which mode is in force so that is never a surprise.
  echo "fleet: dispatching '$name' with --permission-mode $mode --effort $effort" >&2

  # One project = one live worker, ENFORCED rather than noted. What stood here counted
  # the live sessions in $dir, printed a note and dispatched anyway; on 2026-11-19 the
  # note went unread and two workers ran in one checkout. The guard asks the daemon --
  # which owns worker sessions -- and holds the directory across the question AND the
  # dispatch, so two spawns cannot both find it empty. It guards THIS path only; it does
  # not stop anything else running in the same checkout.
  local guard
  guard="${0%/*}/fleet-spawn-guard"; [ -x "$guard" ] || guard=fleet-spawn-guard
  "$guard" guard --dir "$dir" -- claude "${flags[@]}" -- "$prompt"
}

usage() {
  cat <<'USAGE'
fleet — Claude Code background-agent fleet control

  fleet ls [CWD]                 inventory (optionally scoped to one project dir)
  fleet out <id> [lines]         worker's assistant output, from the transcript
                                 (never `claude logs` — that returns ANSI frames)
  fleet why <id>                 why a session is parked: state, detail, needs,
                                 respawnFlags, resumeSessionId (never the whole spec)
  fleet gc [--dry-run] [--stopped]
                                 reap orphaned job state `claude rm` refuses to remove;
                                 leaked `stopped` state is reported, and removed only
                                 with --stopped. A `done` session is never collected.
  fleet watch [interval]         emit one line per state transition (for Monitor)
  fleet spawn --name N --dir PATH --spec FILE [--model M] [--permission-mode M] [--effort E]
                                 dispatch a worker (effort medium by default, no
                                 Explanatory output style), refusing underspecified specs and
                                 refusing a second worker where one is already working
                                 (see `fleet-spawn-guard status --dir PATH`; it guards
                                 this path only, not everything in the checkout)
USAGE
}

case "${1:-}" in
  ls)    shift; cmd_ls "$@" ;;
  out)   shift; cmd_out "$@" ;;
  why)   shift; cmd_why "$@" ;;
  gc)    shift; cmd_gc "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  spawn) shift; cmd_spawn "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
